page {
  --color-bg: #F6F0E4;
  --color-surface: #FFFDF8;
  --color-surface-muted: #EFE6D4;
  --color-ink: #2B2620;
  --color-ink-soft: #6B6255;
  --color-ink-faint: #A69B8A;
  --color-primary: #B8322A;
  --color-primary-soft: #F3DDD6;
  --color-success: #3C7A4E;
  --color-success-soft: #DCEBDD;
  --color-border: #E3D8C3;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 32rpx;
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 34rpx;
  --font-xl: 44rpx;
  --font-title: 56rpx;

  background: var(--color-bg);
  color: var(--color-ink);
  font-size: var(--font-md);
  line-height: 1.6;
}

.page {
  padding: var(--space-lg) var(--space-lg) calc(var(--space-xl) + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: 0 6rpx 24rpx rgba(80, 60, 30, 0.06);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0 var(--space-lg);
  border-radius: 44rpx;
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 88rpx;
}

.btn::after {
  border: none;
}

.btn--primary {
  background: var(--color-primary);
  color: #FFFFFF;
}

.btn--ghost {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.btn--muted {
  background: var(--color-surface-muted);
  color: var(--color-ink-soft);
}

.btn[disabled] {
  opacity: 0.5;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx var(--space-sm);
  border-radius: 999rpx;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 600;
}
