.page { padding: 24rpx 28rpx 60rpx; }
.hero { margin-bottom: 32rpx; }
.hero-title { font-size: 40rpx; font-weight: 600; color: #1A1D26; }
.hero-sub { font-size: 26rpx; color: #8A8F9A; margin-top: 8rpx; }

.card { background: #FFFFFF; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }

.main-action { display: flex; flex-direction: column; background: #4F46E5; }
.ma-title { font-size: 34rpx; font-weight: 600; color: #FFFFFF; }
.ma-desc { font-size: 25rpx; color: rgba(255,255,255,.78); margin-top: 6rpx; }
.ma-arrow { position: absolute; right: 56rpx; margin-top: -70rpx; font-size: 44rpx; color: rgba(255,255,255,.8); }

.join-title { font-size: 30rpx; font-weight: 500; margin-bottom: 18rpx; }
.join-row { display: flex; align-items: center; gap: 16rpx; }
.code-input { flex: 1; background: #F3F4F8; border-radius: 14rpx; padding: 20rpx; font-size: 30rpx; letter-spacing: 4rpx; }
.join-btn { background: #4F46E5; color: #FFFFFF; padding: 20rpx 36rpx; border-radius: 14rpx; font-size: 28rpx; }

.section-title { font-size: 26rpx; color: #8A8F9A; margin: 28rpx 0 12rpx 8rpx; }
.recent-item { display: flex; align-items: center; margin-bottom: 16rpx; }
.recent-main { flex: 1; }
.recent-name { font-size: 30rpx; }
.recent-meta { font-size: 24rpx; color: #8A8F9A; margin-top: 6rpx; }
.closed-tag { margin-left: 12rpx; color: #B7791F; }
.recent-del { color: #C7CAD1; font-size: 34rpx; padding: 0 12rpx; }

.tips { margin-top: 40rpx; padding: 0 8rpx; }
.tip-row { font-size: 24rpx; color: #9AA0AA; line-height: 1.9; }
