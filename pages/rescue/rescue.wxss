.rescue__header {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-lg);
}

.rescue__avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: var(--space-md);
  border-radius: 50%;
}

.rescue__avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 700;
}

.rescue__headline {
  font-size: var(--font-lg);
  font-weight: 700;
}

.rescue__clue-card,
.rescue__waiting {
  margin-bottom: var(--space-xl);
}

.rescue__clue-label {
  margin-bottom: var(--space-xs);
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.rescue__clue {
  font-size: var(--font-lg);
  line-height: 1.8;
}

.rescue__hint {
  margin-top: var(--space-md);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.rescue__result {
  margin-bottom: var(--space-xl);
  text-align: center;
}

.rescue__result-title {
  color: var(--color-success);
  font-weight: 700;
}

.rescue__result-title--big {
  margin-bottom: var(--space-sm);
  font-size: var(--font-xl);
  font-weight: 900;
  animation: rescue-cheer-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1);
}

@keyframes rescue-cheer-pop {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}




.rescue__hanzi {
  padding: var(--space-sm) 0;
  font-weight: 900;
  line-height: 1.3;
  text-align: center;
}

.rescue__hanzi--picture { font-size: 140rpx; }
.rescue__hanzi--pinyin { font-size: 80rpx; }
.rescue__hanzi--radical { font-size: 120rpx; }
.rescue__hanzi--word { font-size: 96rpx; letter-spacing: 10rpx; }

.rescue__typo {
  display: flex;
  justify-content: center;
  margin: var(--space-sm) 0;
}

.rescue__typo-char {
  margin: 0 var(--space-xs);
  font-size: 64rpx;
  font-weight: 800;
}

.rescue__typo-char--wrong {
  color: var(--color-primary);
  text-decoration: underline wavy;
}

.rescue__failed {
  color: var(--color-ink-soft);
  text-align: center;
}

.rescue__failed-title {
  margin-bottom: var(--space-xs);
  color: var(--color-ink);
  font-size: var(--font-lg);
  font-weight: 800;
}
