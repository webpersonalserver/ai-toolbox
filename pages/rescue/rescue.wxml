<loading-skeleton wx:if="{{loading}}" rows="2" />
<view class="page rescue game-theme--{{gameType}}" wx:if="{{!loading}}">
  <view class="rescue__header">
    <image wx:if="{{requesterAvatar}}" class="rescue__avatar" src="{{requesterAvatar}}" mode="aspectFill" />
    <view wx:else class="rescue__avatar rescue__avatar--empty">友</view>
    <view class="rescue__headline">
      <block wx:if="{{isOwner}}">你在{{game.name}}第 {{levelNo}} 关发出了求助</block>
      <block wx:else>{{requesterName}} 被{{game.name}}第 {{levelNo}} 关难住了</block>
    </view>
  </view>

  <block wx:if="{{viewState === 'solved'}}">
    <view class="card rescue__result">
      <view wx:if="{{helpedByMe}}" class="rescue__result-title rescue__result-title--big">🎉 你帮 {{requesterName}} 过关啦！</view>
      <view wx:else class="rescue__result-title">
        <block wx:if="{{isOwner}}">{{helperName}} 帮你解开了这一关</block>
        <block wx:else>这道题已经被 {{helperName}} 解开了</block>
      </view>
      <game-solution game-type="{{gameType}}" solution="{{solution}}" compact />
    </view>
    <button class="btn btn--primary rescue__cta" bindtap="goPlay">{{isOwner ? '继续闯关' : '我也去闯关'}}</button>
  </block>

  <block wx:elif="{{viewState === 'closedByRequester'}}">
    <view class="card rescue__waiting">
      <view class="rescue__clue">{{isOwner ? '你已经自己解开这一关啦' : 'TA 已经自己解开这一关啦'}}</view>
      <view class="rescue__hint">这条求助已结束。</view>
    </view>
    <button class="btn btn--primary rescue__cta" bindtap="goPlay">{{isOwner ? '继续闯关' : '我也去闯关'}}</button>
  </block>

  <block wx:elif="{{viewState === 'ownerWaiting'}}">
    <view class="card rescue__waiting">
      <view class="rescue__clue"><text wx:for="{{clueSegments}}" wx:key="index" class="{{item.masked ? 'clue-mask' : ''}}">{{item.text}}</text></view>
      <view class="rescue__hint">等好友来帮你解开，答对后你会直接过关。</view>
    </view>
    <button class="btn btn--muted rescue__cta" bindtap="goPlay">返回关卡</button>
  </block>

  <block wx:elif="{{helperBlocked}}">
    <view class="card rescue__waiting">
      <view class="rescue__clue">{{helperBlockedMessage}}</view>
      <view class="rescue__hint">换一位好友来帮 TA 吧，你也可以自己去闯关。</view>
    </view>
    <button class="btn btn--primary rescue__cta" bindtap="goPlay">我也去闯关</button>
  </block>

  <block wx:else>
    <view class="card rescue__clue-card">
      <view class="rescue__clue-label">{{clueLabel}}</view>
      <view wx:if="{{gameType === 'hanzi'}}" class="rescue__hanzi rescue__hanzi--{{hanziKind}}">{{clue}}</view>
      <view wx:elif="{{gameType === 'typo'}}" class="rescue__typo">
        <text wx:for="{{clueChars}}" wx:key="index" class="rescue__typo-char {{item.wrong ? 'rescue__typo-char--wrong' : ''}}">{{item.char}}</text>
      </view>
      <view wx:else class="rescue__clue"><text wx:for="{{clueSegments}}" wx:key="index" class="{{item.masked ? 'clue-mask' : ''}}">{{item.text}}</text></view>
      <view wx:if="{{clueHint}}" class="rescue__hint">释义：<text wx:for="{{clueHintSegments}}" wx:key="index" class="{{item.masked ? 'clue-mask clue-mask--small' : ''}}">{{item.text}}</text></view>
      <view wx:if="{{poemSource}}" class="rescue__hint">{{poemSource}}</view>
      <view wx:if="{{meaning}}" class="rescue__hint">💡 意思：{{meaning}}</view>
      <view class="rescue__hint">你有 {{helperAttemptsLeft}} 颗❤️，答错一次少一颗</view>
    </view>
    <char-puzzle
      id="puzzle"
      board="{{board}}"
      answer-length="{{answerLength}}"
      answer-pinyin="{{answerPinyin}}"
      columns="{{game.boardColumns}}"
      disabled="{{submitting}}"
      checking="{{submitting}}"
      bind:complete="handleComplete"
    />
  </block>
</view>
