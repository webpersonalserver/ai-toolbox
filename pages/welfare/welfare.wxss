/* The banner is the first thing a child reads: big, warm and telling them what to do next. */
.welfare__summary {
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-lg);
  background: var(--color-gold-soft);
  color: var(--color-ink);
  font-size: var(--font-lg);
  font-weight: 800;
}

.welfare__row {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-md);
}

.welfare__icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-right: var(--space-md);
  border-radius: var(--radius-md);
  color: var(--color-on-accent);
  font-size: var(--font-lg);
  font-weight: 800;
}

.welfare__icon--image {
  background: var(--color-gold-soft);
  padding: 14rpx;
  box-sizing: border-box;
}

.welfare__icon--chest {
  background: var(--color-gold-soft);
  font-size: var(--font-xl);
}

.welfare__body {
  flex: 1;
  min-width: 0;
}

.welfare__name {
  font-size: var(--font-md);
  font-weight: 800;
}

.welfare__desc {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.btn.welfare__action {
  flex-shrink: 0;
  margin-left: var(--space-md);
  width: auto;
  /* Big enough for small fingers. */
  min-width: 168rpx;
  padding: 0 var(--space-md);
  height: 80rpx;
  line-height: 80rpx;
  font-size: var(--font-md);
}

.welfare__done {
  flex-shrink: 0;
  margin-left: var(--space-md);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}

.welfare__section-title {
  margin: var(--space-lg) 0 var(--space-md);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  font-weight: 700;
}

.welfare__row--done {
  opacity: 0.55;
}

.welfare__icon--task {
  background: var(--color-success);
  box-shadow: 0 6rpx 0 var(--color-success-deep);
}

.welfare__failed {
  padding-top: 160rpx;
  text-align: center;
}

.welfare__failed-icon {
  font-size: 120rpx;
}

.welfare__failed-text {
  margin: var(--space-md) 0 var(--space-xl);
  color: var(--color-ink-soft);
  font-size: var(--font-lg);
  font-weight: 800;
}
