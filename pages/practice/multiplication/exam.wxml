<view wx:if="{{!started}}" class="page exam-intro">
  <view class="exam-intro__card">
    <view class="exam-intro__icon">⚔️</view>
    <view class="exam-intro__title">华山论剑</view>
    <view class="exam-intro__rules">
      <view>· 共 {{questionCount}} 题，九重口诀随机出</view>
      <view>· 只有 {{lives}} 条命，答错一题少一条</view>
      <view>· 闯完全部题目，即为神功大成</view>
    </view>
    <view wx:if="{{previousBest}}" class="exam-intro__best">{{previousBest}}</view>
    <button class="btn btn--primary exam-intro__start" bindtap="startExam">开始考核</button>
  </view>
</view>

<view wx:else class="page exam">
  <view class="exam__top">
    <view class="exam__hearts">
      <text wx:for="{{hearts}}" wx:key="id" class="exam__heart {{item.alive ? '' : 'exam__heart--lost'}}">❤️</text>
    </view>
    <view class="exam__meta">
      <view>{{progressText}}</view>
      <view class="exam__clock">⏱ {{elapsedText}}</view>
    </view>
  </view>
  <view wx:if="{{combo >= 2}}" class="exam__combo">🔥 {{combo}} 连击</view>
  <view class="exam__feedback">{{feedbackLine}}</view>

  <kungfu-question
    question="{{question}}"
    locked="{{locked}}"
    revealed="{{revealed}}"
    bind:answered="handleAnswered"
    bind:empty="handleEmpty"
  />
</view>

<practice-cheer
  visible="{{cheer.visible}}"
  title="{{cheer.title}}"
  subtitle="{{cheer.subtitle}}"
  mascot="{{cheer.mascot}}"
  big="{{cheer.big}}"
  flying-star="{{false}}"
/>

<kungfu-result
  visible="{{result.visible}}"
  kind="{{result.kind}}"
  heading="{{result.heading}}"
  title="{{result.title}}"
  subtitle="{{result.subtitle}}"
  lines="{{result.lines}}"
  actions="{{result.actions}}"
  bind:action="handleResultAction"
/>
