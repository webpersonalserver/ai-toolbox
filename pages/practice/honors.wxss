.honors__flowers {
  padding: var(--space-xl) var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--color-primary-soft);
  box-shadow: 0 10rpx 0 var(--color-primary);
  text-align: center;
}

.honors__flower-icon {
  font-size: 120rpx;
  line-height: 1;
}

.honors__flower-count {
  color: var(--color-primary-deep);
  font-size: 96rpx;
  font-weight: 900;
  line-height: 1.1;
}

.honors__flower-label {
  font-weight: 800;
}

.honors__stats {
  display: flex;
  justify-content: center;
  gap: var(--space-md);
  margin-top: var(--space-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.honors__summary {
  margin: var(--space-lg) 0 var(--space-md);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  text-align: center;
}

.honors__group {
  margin-bottom: var(--space-lg);
}

.honors__group-title {
  margin-bottom: var(--space-sm);
  font-size: var(--font-lg);
  font-weight: 900;
}

.honors__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
}

.honors__medal {
  padding: var(--space-md) var(--space-xs);
  border-radius: var(--radius-md);
  background: var(--color-surface-muted);
  text-align: center;
}

.honors__medal--unlocked {
  background: var(--color-gold-soft);
  box-shadow: 0 6rpx 0 var(--color-gold);
}

.honors__medal--pressed {
  transform: translateY(6rpx);
  box-shadow: none;
}

.honors__disc {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border: 6rpx solid var(--color-border);
  border-radius: 50%;
  background: var(--color-surface);
  font-size: 60rpx;
  filter: grayscale(1);
  opacity: 0.5;
  box-sizing: border-box;
}

.honors__medal--unlocked .honors__disc {
  border-color: var(--color-gold);
  filter: none;
  opacity: 1;
}

.honors__name {
  margin-top: var(--space-xs);
  font-size: var(--font-sm);
  font-weight: 800;
}

.honors__progress {
  color: var(--color-ink-faint);
  font-size: 22rpx;
}

.honors__share.btn {
  width: 100%;
  margin-top: var(--space-md);
}
