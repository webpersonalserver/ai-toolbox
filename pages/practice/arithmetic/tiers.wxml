<view class="page tiers">
  <view class="tiers__hint">选一个档位开始。答对题数和连对数达标能攒宝箱，去福利袋打开</view>
  <view
    wx:for="{{tiers}}"
    wx:key="tier"
    class="card tiers__card tiers__card--{{item.tier}}"
    hover-class="tiers__card--pressed"
    data-tier="{{item.tier}}"
    bindtap="openTier"
  >
    <view class="tiers__main">
      <view class="tiers__label">{{item.label}}</view>
      <view class="tiers__example">{{item.example}}</view>
      <view wx:if="{{item.solvedText}}" class="tiers__solved">{{item.solvedText}}</view>
    </view>
    <view class="tiers__record">
      <view class="tiers__record-value">{{item.bestStreakText}}</view>
      <view class="tiers__record-label">最佳连对</view>
    </view>
  </view>
</view>
