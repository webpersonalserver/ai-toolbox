<view class="page practice">
  <view class="practice__sky" aria-hidden="true">
    <text class="practice__float practice__float--1">⭐</text>
    <text class="practice__float practice__float--2">☁️</text>
    <text class="practice__float practice__float--3">✨</text>
    <text class="practice__float practice__float--4">⭐</text>
  </view>

  <view class="practice__hero">
    <image class="practice__mascot" src="{{mascot.images.happy}}" mode="aspectFit" />
    <view class="practice__speech">
      <view class="practice__speech-name">{{mascot.name}}</view>
      <view class="practice__speech-text">{{greeting}}</view>
    </view>
  </view>

  <view class="practice__honors" hover-class="practice__card--pressed" bindtap="openHonors">
    <view class="practice__honor-row">
      <view class="practice__honor practice__honor--flower">
        <view wx:if="{{honors.todayFlowers}}" class="practice__honor-today">今天 +{{honors.todayFlowers}}</view>
        <view class="practice__honor-value">🌺 {{honors.flowers}}</view>
        <view class="practice__honor-label">小红花</view>
      </view>
      <view class="practice__honor practice__honor--medal">
        <view class="practice__honor-value">🏅 {{honors.unlockedCount}}</view>
        <view class="practice__honor-label">已得奖章</view>
      </view>
      <view class="practice__honor practice__honor--streak">
        <view class="practice__honor-value">🔥 {{honors.dayStreak}}</view>
        <view class="practice__honor-label">连续练习天数</view>
      </view>
    </view>
    <view class="practice__honors-link">荣誉墙 ›</view>
  </view>

  <view class="practice__weekly" hover-class="practice__card--pressed" bindtap="openWeekly">
    <text>{{weeklyLabel}}</text>
    <text class="practice__weekly-hint">这周练得怎么样？给爸爸妈妈看看 ›</text>
  </view>

  <view
    wx:for="{{subjects}}"
    wx:key="id"
    class="practice__subject practice__subject--{{item.id}} {{item.open ? 'practice__subject--open' : 'practice__subject--fog'}}"
    hover-class="practice__subject--pressed"
    data-id="{{item.id}}"
    bindtap="openSubject"
  >
    <view class="practice__portal">{{item.icon}}</view>
    <view class="practice__body">
      <view class="practice__subject-tag">{{item.open ? tags.open : tags.building}}</view>
      <view class="practice__subject-name">{{item.name}}</view>
      <view class="practice__intro">{{item.intro}}</view>
    </view>
    <view wx:if="{{item.open}}" class="practice__go">GO</view>
    <view wx:else class="practice__clouds">
      <text class="practice__cloud practice__cloud--1">☁️</text>
      <text class="practice__cloud practice__cloud--2">☁️</text>
    </view>
  </view>
</view>
