<loading-skeleton wx:if="{{loading}}" rows="3" />
<view wx:elif="{{honors}}" class="page honors">
  <view class="honors__flowers">
    <view class="honors__flower-icon">🌺</view>
    <view class="honors__flower-count">{{honors.flowers}}</view>
    <view class="honors__flower-label">朵小红花</view>
    <view class="honors__stats">
      <text>今天 +{{honors.todayFlowers}}</text>
      <text>连续练习 {{honors.dayStreak}} 天</text>
      <text>最长 {{honors.bestDayStreak}} 天</text>
    </view>
  </view>

  <view class="honors__summary">已获得 {{honors.unlockedCount}} / {{honors.medalCount}} 枚奖章，点奖章看看怎么得</view>

  <view wx:for="{{honors.groups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="id" class="honors__group">
    <view class="honors__group-title">{{group.name}}</view>
    <view class="honors__grid">
      <view
        wx:for="{{group.medals}}"
        wx:for-item="medal"
        wx:for-index="medalIndex"
        wx:key="id"
        class="honors__medal {{medal.unlocked ? 'honors__medal--unlocked' : ''}}"
        hover-class="honors__medal--pressed"
        data-group-index="{{groupIndex}}"
        data-medal-index="{{medalIndex}}"
        bindtap="openMedal"
      >
        <view class="honors__disc">{{medal.icon}}</view>
        <view class="honors__name">{{medal.name}}</view>
        <view wx:if="{{!medal.unlocked}}" class="honors__progress">{{medal.current}}/{{medal.target}}</view>
      </view>
    </view>
  </view>

  <button class="btn btn--ghost honors__share" open-type="share">分享我的荣誉墙</button>
</view>

<medal-popup visible="{{medalPopup.visible}}" is-new="{{medalPopup.isNew}}" medal="{{medalPopup.medal}}" bind:close="handleMedalClose" />
