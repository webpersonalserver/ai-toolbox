/* 今天: four numbers, two to a row. */
.admin__cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.admin__card {
  padding: var(--space-md);
  text-align: center;
}

.admin__card-value {
  color: var(--color-primary);
  font-size: var(--font-xl);
  font-weight: 800;
}

.admin__card-value--small {
  font-size: var(--font-md);
  line-height: 1.6;
}

.admin__card-label {
  color: var(--color-ink-soft);
  font-size: 22rpx;
}

.admin__tabs {
  margin: 0 0 var(--space-md);
}

.admin__list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-xs);
}

.admin__list-title {
  font-weight: 800;
}

.admin__sorts {
  display: flex;
  gap: var(--space-xs);
}

.admin__sort {
  padding: 4rpx var(--space-sm);
  border-radius: 999rpx;
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.admin__sort--on {
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-weight: 800;
}

.admin__section-title {
  margin: var(--space-md) 0;
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  font-weight: 600;
}

.admin__list {
  margin-bottom: var(--space-lg);
}

.admin__empty,
.admin__hint {
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
  text-align: center;
}

.admin__hint {
  margin-top: var(--space-sm);
}

.admin__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) 0;
  border-bottom: 2rpx solid var(--color-border);
  font-size: var(--font-sm);
}

.admin__row--head {
  color: var(--color-ink-faint);
}

.admin__row-main {
  font-weight: 700;
}

.admin__row-side {
  color: var(--color-ink-soft);
}

.admin__cell {
  flex: 1;
  text-align: center;
}

.admin__cell:first-child {
  flex: 1.4;
  text-align: left;
}
