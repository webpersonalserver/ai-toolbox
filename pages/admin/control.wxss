.control__intro {
  margin-bottom: var(--space-md);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.control__group {
  margin-bottom: var(--space-lg);
}

/* Which part of the app the switches below change. */
.control__module {
  margin-bottom: var(--space-sm);
  padding-left: var(--space-sm);
  border-left: 8rpx solid var(--color-primary);
  color: var(--color-ink);
  font-size: var(--font-sm);
  font-weight: 900;
}

.control__row {
  margin-bottom: var(--space-md);
}

.control__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
  margin-bottom: var(--space-sm);
}

/* Tap for the full explanation (what it controls, on / off). */
.control__help {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-left: var(--space-sm);
  border-radius: 50%;
  background: var(--color-surface-muted);
  color: var(--color-ink-soft);
  font-size: 24rpx;
  font-weight: 900;
}

.control__line {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  line-height: 1.5;
}

/* The state players are in right now, so the admin does not have to read the switch. */
.control__state {
  margin-top: var(--space-sm);
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background: var(--color-surface-muted);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  font-weight: 700;
}

.control__state--on {
  background: var(--color-success-soft);
  color: var(--color-success-deep);
}

/* Name and ? stay on one row: a long name wraps by itself, the ? never drops to a line of its own. */
.control__name {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  font-size: var(--font-md);
  font-weight: 800;
}

.control__name-text {
  min-width: 0;
}

.control__failed {
  margin-bottom: var(--space-md);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.control__retry {
  margin-left: var(--space-sm);
  color: var(--color-primary-deep);
  font-weight: 800;
}
