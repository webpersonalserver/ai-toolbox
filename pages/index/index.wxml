<view class="page hall">
  <view class="hall__header">
    <view class="hall__title">解谜达人</view>
    <view class="hall__items">
      <view class="chip">体力 {{items.stamina}}</view>
      <view class="chip">提示 {{items.hint}}</view>
    </view>
  </view>
  <view wx:if="{{staminaRecoveryText}}" class="hall__recovery">体力 {{staminaRecoveryText}}</view>

  <view class="card hall__checkin">
    <view>
      <view class="hall__checkin-title">{{checkedIn ? '今日已打卡' : '每日打卡'}}</view>
      <view class="hall__checkin-desc">{{checkedIn ? '明天再来领取' : '领取' + checkinRewardText}}</view>
    </view>
    <button class="btn {{checkedIn ? 'btn--muted' : 'btn--primary'}} hall__checkin-btn" disabled="{{checkedIn}}" bindtap="handleCheckin">
      {{checkedIn ? '已领取' : '打卡'}}
    </button>
  </view>

  <view class="hall__section-title">玩法</view>

  <view
    wx:for="{{gameCards}}"
    wx:key="gameType"
    class="card hall__game"
    hover-class="hall__game--pressed"
    data-game-type="{{item.gameType}}"
    bindtap="openGame"
  >
    <view class="hall__game-icon">{{item.icon}}</view>
    <view class="hall__game-body">
      <view class="hall__game-name">
        {{item.name}}
        <text wx:if="{{item.titleName}}" class="chip hall__game-title">{{item.titleName}}</text>
      </view>
      <view wx:if="{{item.allCleared}}" class="hall__game-desc">已通关全部 {{item.total}} 关 · 更多挑战敬请期待</view>
      <view wx:elif="{{item.total}}" class="hall__game-desc">已通过 {{item.solvedCount}} / {{item.total}} 关 · {{item.titleProgressText}}</view>
      <view wx:else class="hall__game-desc">{{item.intro}}</view>
      <view wx:if="{{item.pendingChests > 0}}" class="hall__game-chest">有 {{item.pendingChests}} 个宝箱待打开</view>
    </view>
    <view class="hall__game-action">闯关</view>
  </view>

  <view class="card hall__game" hover-class="hall__game--pressed" bindtap="openLeaderboard">
    <view class="hall__game-icon hall__game-icon--gold">榜</view>
    <view class="hall__game-body">
      <view class="hall__game-name">排行榜</view>
      <view class="hall__game-desc">看看谁闯得最远</view>
    </view>
    <view class="hall__game-action">查看</view>
  </view>

  <view class="card hall__game hall__game--coming">
    <view class="hall__game-icon hall__game-icon--muted">?</view>
    <view class="hall__game-body">
      <view class="hall__game-name">更多玩法</view>
      <view class="hall__game-desc">敬请期待</view>
    </view>
  </view>
</view>
