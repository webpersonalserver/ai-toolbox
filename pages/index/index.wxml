<view class="page hall">
  <view class="hall__header">
    <view class="hall__title">解谜达人</view>
    <view class="hall__items">
      <item-chip item-type="stamina" value="{{items.stamina}}" />
      <item-chip item-type="hint" value="{{items.hint}}" />
    </view>
  </view>
  <view wx:if="{{staminaRecoveryText}}" class="hall__recovery"><image class="inline-icon" src="/assets/icons/stamina.png" mode="aspectFit" />{{staminaRecoveryText}}</view>

  <view class="card hall__checkin">
    <view>
      <view class="hall__checkin-title">{{checkedIn ? '今日已打卡' : '每日打卡'}}</view>
      <view class="hall__checkin-desc">{{checkedIn ? '明天再来领取' : '领取' + checkinRewardText}}</view>
    </view>
    <button class="btn {{checkedIn ? 'btn--muted' : 'btn--primary'}} hall__checkin-btn" disabled="{{checkedIn}}" bindtap="handleCheckin">
      {{checkedIn ? '已领取' : '打卡'}}
    </button>
  </view>

  <view class="hall__section-title">玩法</view>

  <view
    wx:for="{{gameCards}}"
    wx:key="gameType"
    class="card hall__game game-theme--{{item.gameType}}"
    hover-class="hall__game--pressed"
    data-game-type="{{item.gameType}}"
    bindtap="openGame"
  >
    <view class="hall__game-icon">{{item.icon}}</view>
    <view class="hall__game-body">
      <view class="hall__game-name">
        {{item.name}}
        <text wx:if="{{item.titleName}}" class="chip hall__game-title">{{item.titleName}}</text>
      </view>
      <view wx:if="{{item.allCleared}}" class="hall__game-desc">已通关全部关卡 · 更多挑战敬请期待</view>
      <view wx:elif="{{item.total}}" class="hall__game-desc">已通过 {{item.solvedCount}} 关 · {{item.titleProgressText}}</view>
      <view wx:else class="hall__game-desc">{{item.intro}}</view>
      <view wx:if="{{item.pendingChests > 0}}" class="hall__game-chest">有 {{item.pendingChests}} 个宝箱待打开</view>
    </view>
    <view
      wx:if="{{!item.allCleared && item.total}}"
      class="hall__continue"
      hover-class="hall__continue--pressed"
      data-game-type="{{item.gameType}}"
      data-level-no="{{item.currentLevel}}"
      catchtap="continueGame"
    >
      <view class="hall__continue-label">继续</view>
      <view class="hall__continue-level">第 {{item.currentLevel}} 关</view>
    </view>
    <view wx:else class="hall__game-action">查看</view>
  </view>

  <view class="card hall__game hall__game--coming">
    <view class="hall__game-icon hall__game-icon--muted">?</view>
    <view class="hall__game-body">
      <view class="hall__game-name">更多玩法</view>
      <view class="hall__game-desc">敬请期待</view>
    </view>
  </view>
</view>

<profile-editor
  visible="{{welcomeVisible}}"
  title="欢迎来到解谜达人"
  intro="点头像可以用微信头像，点昵称输入框，键盘上方可以一键填入微信昵称"
  cancel-text="先随便逛逛"
  avatar-url="{{profileAvatarUrl}}"
  nickname="{{profileNickname}}"
  allow-unchanged
  bind:saved="handleWelcomeSaved"
  bind:cancel="handleWelcomeSkipped"
/>
