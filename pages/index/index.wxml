<view class="page hall {{adOffers.length ? 'hall--with-fab' : ''}}">
  <view class="hall__header">
    <view class="hall__title">喵喵状元郎</view>
    <view class="hall__items">
      <item-chip item-type="stamina" value="{{items.stamina}}" />
      <item-chip item-type="hint" value="{{items.hint}}" />
    </view>
  </view>
  <view class="card hall__welfare {{unclaimedWelfare ? 'hall__welfare--has' : ''}}" hover-class="hall__game--pressed" bindtap="openWelfare">
    <view class="hall__welfare-icon">🎁</view>
    <view class="hall__welfare-body">
      <view class="hall__welfare-title">
        福利袋
        <text wx:if="{{unclaimedWelfare}}" class="hall__welfare-badge">{{unclaimedWelfare}}</text>
      </view>
      <view class="hall__welfare-desc">{{welfareDesc}}</view>
    </view>
    <view class="hall__game-action">{{checkedIn ? '打开 ›' : '去打卡 ›'}}</view>
  </view>

  <view class="hall__section-title">为你推荐</view>
  <view class="card hall__game hall__daily {{dailyDone ? 'hall__daily--done' : ''}}" hover-class="hall__game--pressed" bindtap="openDaily">
    <view class="hall__game-icon hall__daily-icon">📅</view>
    <view class="hall__game-body">
      <view class="hall__game-name">今日挑战</view>
      <view class="hall__game-desc">{{dailyDesc}}</view>
    </view>
    <view class="hall__game-action">{{dailyDone ? '看成绩 ›' : '去挑战 ›'}}</view>
  </view>

  <!-- One full-width card per subject: the game, why it is picked, and the level it opens. -->
  <view wx:if="{{recommendations.length}}" class="hall__picks">
    <view
      wx:for="{{recommendations}}"
      wx:key="subjectId"
      class="card hall__game hall__pick game-theme--{{item.card.gameType}}"
      hover-class="hall__game--pressed"
      data-game-type="{{item.card.gameType}}"
      data-level-no="{{item.levelNo}}"
      bindtap="openRecommendation"
    >
      <view class="hall__game-icon">{{item.card.icon}}</view>
      <view class="hall__game-body">
        <view class="hall__game-name">
          {{item.card.name}}
          <text class="hall__pick-subject">{{item.subjectName}}</text>
        </view>
        <view class="hall__game-desc">{{item.reason}}</view>
      </view>
      <view class="hall__continue">
        <view class="hall__continue-label">{{item.levelNo > 1 ? '继续' : '开始'}}</view>
        <view class="hall__continue-level">第 {{item.levelNo}} 关</view>
      </view>
    </view>
  </view>

  <view class="hall__section-title">全部玩法</view>
  <view class="hall__tabs">
    <view
      wx:for="{{subjectTabs}}"
      wx:key="id"
      class="hall__tab {{item.active ? 'hall__tab--active' : ''}}"
      data-id="{{item.id}}"
      bindtap="chooseSubject"
    >{{item.icon}} {{item.name}}</view>
  </view>

  <view wx:if="{{comingSoon}}" class="card hall__soon">🎠 字母乐园正在建造中，英语玩法敬请期待～</view>

  <view
    wx:for="{{subjectCards}}"
    wx:key="gameType"
    class="card hall__game game-theme--{{item.gameType}}"
    hover-class="hall__game--pressed"
    data-game-type="{{item.gameType}}"
    bindtap="openGame"
  >
    <view class="hall__game-icon">{{item.icon}}</view>
    <view class="hall__game-body">
      <view class="hall__game-name">
        {{item.name}}
        <text wx:if="{{item.titleName}}" class="chip hall__game-title">{{item.titleName}}</text>
      </view>
      <view wx:if="{{item.allCleared}}" class="hall__game-desc">全部闯过啦！新关卡正在路上～</view>
      <view wx:elif="{{item.total}}" class="hall__game-desc">已闯过 {{item.solvedCount}} 关 · {{item.titleProgressText}}</view>
      <view wx:else class="hall__game-desc">{{item.intro}}</view>
      <view wx:if="{{item.pendingChests > 0}}" class="hall__game-chest">有 {{item.pendingChests}} 个宝箱待打开</view>
    </view>
    <view
      wx:if="{{!item.allCleared && item.total}}"
      class="hall__continue"
      hover-class="hall__continue--pressed"
      data-game-type="{{item.gameType}}"
      data-level-no="{{item.currentLevel}}"
      catchtap="continueGame"
    >
      <view class="hall__continue-label">继续</view>
      <view class="hall__continue-level">第 {{item.currentLevel}} 关</view>
    </view>
    <view wx:else class="hall__game-action">查看</view>
  </view>

  <view wx:if="{{showSprint}}" class="card hall__game hall__sprint game-theme--{{sprintCard.themeGame}}" hover-class="hall__game--pressed" bindtap="openSprint">
    <view class="hall__game-icon">速</view>
    <view class="hall__game-body">
      <view class="hall__game-name">{{sprintCard.name}}</view>
      <view class="hall__game-desc">{{sprintCard.intro}}</view>
    </view>
    <view class="hall__game-action">去挑战 ›</view>
  </view>
</view>

<ad-reward-fab offers="{{adOffers}}" bind:rewarded="handleAdRewarded" />

<reward-popup
  visible="{{rewardPopup.visible}}"
  title="{{rewardPopup.title}}"
  subtitle="{{rewardPopup.subtitle}}"
  badge="{{rewardPopup.badge}}"
  rewards="{{rewardPopup.rewards}}"
  double-token="{{rewardPopup.doubleToken}}"
  sound="{{rewardPopup.sound}}"
  bind:close="closeRewardPopup"
/>

<profile-editor
  visible="{{welcomeVisible}}"
  title="欢迎来到喵喵状元郎"
  intro="换个头像，起个好听的名字吧！"
  cancel-text="先随便逛逛"
  avatar-url="{{profileAvatarUrl}}"
  nickname="{{profileNickname}}"
  allow-unchanged
  bind:saved="handleWelcomeSaved"
  bind:cancel="handleWelcomeSkipped"
/>
