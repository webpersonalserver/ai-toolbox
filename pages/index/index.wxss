.hall__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.hall__title {
  font-size: var(--font-title);
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hall__items {
  display: flex;
  gap: var(--space-sm);
}

/* Spacing rhythm: cards in a group sit var(--space-md) apart; a section title adds var(--space-lg) above itself,
   so groups are var(--space-md) + var(--space-lg) apart, and a title sits var(--space-md) above its cards. */
.hall__welfare {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.hall__welfare--has {
  background: var(--color-gold-soft);
}

.hall__welfare-icon {
  font-size: 64rpx;
}

.hall__welfare-body {
  flex: 1;
}

.hall__welfare-title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.hall__welfare-badge {
  display: inline-block;
  min-width: 36rpx;
  margin-left: 8rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-on-accent);
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
  vertical-align: middle;
}

.hall__welfare-desc {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.hall__section-title {
  margin: var(--space-lg) 0 var(--space-md);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.hall__game {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-md);
}

.hall__game--pressed {
  opacity: 0.85;
}

.hall__game-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-right: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--game-color);
  box-shadow: 0 6rpx 0 var(--game-color-deep);
  color: var(--color-on-accent);
  font-size: var(--font-xl);
  font-weight: 800;
}

.hall__game-body {
  flex: 1;
  min-width: 0;
}

.hall__game-name {
  font-size: var(--font-lg);
  font-weight: 700;
}

.hall__game-title {
  margin-left: var(--space-xs);
  vertical-align: middle;
}

.hall__game-chest {
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 700;
}

.hall__game-desc {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.hall__continue {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: var(--space-md);
  margin-bottom: var(--jelly-depth);
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--game-color);
  box-shadow: 0 var(--jelly-depth) 0 var(--game-color-deep);
  color: var(--color-on-accent);
  line-height: 1.3;
}

.hall__continue--pressed {
  transform: translateY(var(--jelly-depth));
  box-shadow: none;
}

.hall__continue-label {
  font-size: var(--font-md);
  font-weight: 800;
}

.hall__continue-level {
  font-size: 20rpx;
  opacity: 0.9;
}

.hall__game-action {
  flex-shrink: 0;
  margin-left: var(--space-md);
  color: var(--game-color-deep);
  font-weight: 700;
  white-space: nowrap;
}

/* Room under the last card so the floating video button never covers it. */
.page.hall--with-fab {
  padding-bottom: calc(128rpx + var(--space-xl) * 2 + env(safe-area-inset-bottom));
}

/* 今日挑战: same card shape as the games, warm gold until it is done for the day. */
.hall__daily {
  background: var(--color-gold-soft);
}

.hall__daily--done {
  background: var(--color-surface);
}

.hall__daily-icon {
  background: var(--color-surface);
}

/* 口算竞速 / 识字竞速: a challenge, so it stands out from the game list in its subject's colour. */
.hall__sprint {
  background: var(--game-color-soft);
}

/* 为你推荐: one full-width card per subject, the same shape as the game list but tinted, so the next step is obvious. */
.hall__picks {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.hall__pick {
  margin-bottom: 0;
  background: var(--game-color-soft);
}

.hall__pick-subject {
  margin-left: var(--space-xs);
  padding: 2rpx var(--space-sm);
  border-radius: 999rpx;
  background: var(--color-surface);
  color: var(--game-color-deep);
  font-size: 22rpx;
  font-weight: 900;
  vertical-align: middle;
}

/* 全部玩法: 汉字城堡 / 数字星球 / 字母乐园, one subject at a time. */
.hall__tabs {
  display: flex;
  gap: var(--space-xs);
  margin-bottom: var(--space-md);
  padding: var(--space-xs);
  border-radius: var(--radius-md);
  background: var(--color-surface-muted);
}

.hall__tab {
  flex: 1;
  padding: var(--space-sm) 0;
  border-radius: var(--radius-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-md);
  font-weight: 800;
  text-align: center;
}

.hall__tab--active {
  background: var(--color-surface);
  box-shadow: 0 4rpx 0 var(--color-border);
  color: var(--color-primary-deep);
}

.hall__soon {
  color: var(--color-ink-soft);
  text-align: center;
}
