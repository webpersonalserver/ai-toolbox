.hall__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.hall__title {
  font-size: var(--font-title);
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hall__items {
  display: flex;
  gap: var(--space-sm);
}

.hall__recovery {
  margin: calc(var(--space-md) * -1) 0 var(--space-md);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
  text-align: right;
}

.hall__checkin {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-xl);
}

.hall__checkin-title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.hall__checkin-desc {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.btn.hall__checkin-btn {
  width: 180rpx;
}

.hall__section-title {
  margin-bottom: var(--space-md);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  font-weight: 600;
  letter-spacing: 4rpx;
}

.hall__game {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-md);
}

.hall__game--pressed {
  opacity: 0.85;
}

.hall__game--coming {
  opacity: 0.6;
}

.hall__game-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  margin-right: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--game-color);
  box-shadow: 0 6rpx 0 var(--game-color-deep);
  color: var(--color-on-accent);
  font-size: var(--font-xl);
  font-weight: 800;
}

.hall__game-icon--muted {
  background: var(--color-surface-muted);
  color: var(--color-ink-faint);
}

.hall__game-body {
  flex: 1;
}

.hall__game-name {
  font-size: var(--font-lg);
  font-weight: 700;
}

.hall__game-title {
  margin-left: var(--space-xs);
  vertical-align: middle;
}

.hall__game-chest {
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 700;
}

.hall__game-desc {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.hall__continue {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-left: var(--space-sm);
  margin-bottom: var(--jelly-depth);
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--game-color);
  box-shadow: 0 var(--jelly-depth) 0 var(--game-color-deep);
  color: var(--color-on-accent);
  line-height: 1.3;
}

.hall__continue--pressed {
  transform: translateY(var(--jelly-depth));
  box-shadow: none;
}

.hall__continue-label {
  font-size: var(--font-md);
  font-weight: 800;
}

.hall__continue-level {
  font-size: 20rpx;
  opacity: 0.9;
}

.hall__game-action {
  color: var(--game-color-deep);
  font-weight: 700;
}
