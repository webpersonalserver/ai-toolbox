/* pages/index/index.wxss */
.hero {
  background: linear-gradient(135deg, #4F46E5, #7C3AED);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  color: #fff;
  margin-bottom: 30rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}
.hero-sub {
  font-size: 26rpx;
  opacity: 0.85;
  margin-top: 12rpx;
}
.tool-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 34rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.tool-icon {
  font-size: 52rpx;
  margin-right: 26rpx;
}
.tool-info {
  flex: 1;
}
.tool-title {
  font-size: 32rpx;
  font-weight: 600;
}
.tool-tag {
  font-size: 20rpx;
  color: #4F46E5;
  background: #EEF2FF;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.tool-desc {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 8rpx;
}
.tool-arrow {
  color: #C7CAD1;
  font-size: 40rpx;
}
.notice {
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 20rpx;
}
