<loading-skeleton wx:if="{{loading}}" rows="3" />
<view class="page book" wx:if="{{!loading}}">
  <view wx:if="{{loadFailed}}" class="card book__empty" bindtap="retryLoad">
    <view class="book__empty-title">📶 没连上网络</view>
    <view>点我再试一次</view>
  </view>

  <block wx:else>
  <view class="book__summary">已收录 {{total}} {{game.bookUnit}}<text wx:if="{{expandable && total}}"> · 点卡片看详细解释</text></view>

  <view wx:if="{{!total}}" class="card book__empty">
    <view class="book__empty-title">这里还空空的</view>
    <view>每闯过一关，就会收进{{game.bookName}}哦</view>
    <button class="btn btn--primary book__empty-btn" bindtap="goPlay">去闯第一关</button>
  </view>

  <view
    wx:for="{{entries}}"
    wx:key="levelNo"
    class="card book__entry"
    data-level-no="{{item.levelNo}}"
    bindtap="toggleEntry"
  >
    <view class="book__level">第 {{item.levelNo}} 关<text wx:if="{{item.stage}}"> · {{item.stage}}</text></view>
    <game-solution game-type="{{gameType}}" solution="{{item}}" compact="{{expandedLevelNo !== item.levelNo}}" />
  </view>

  <view wx:if="{{loadingMore}}" class="book__footer">加载中…</view>
  </block>
</view>
