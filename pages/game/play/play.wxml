<loading-skeleton wx:if="{{stage === 'loading'}}" rows="3" />
<view class="page play game-theme--{{gameType}}" wx:if="{{stage !== 'loading'}}">
  <view class="play__topbar">
    <view>
      <view wx:if="{{stageName}}" class="play__stage">{{stageName}}</view>
      <view class="play__level">第 {{levelNo}} 关</view>
    </view>
    <view class="play__items">
      <item-chip item-type="stamina" value="{{items.stamina}}" />
      <item-chip item-type="hint" value="{{items.hint}}" />
    </view>
  </view>

  <view wx:if="{{stage === 'next'}}" class="play__next">
    <view class="play__next-label">下一关</view>
    <view class="play__next-level">第 {{levelNo}} 关</view>
    <view class="play__next-go">出发！</view>
  </view>

  <view wx:if="{{stage === 'error'}}" class="card play__ready">
    <view class="play__ready-title">网络开小差了</view>
    <view class="play__ready-desc">检查一下网络，再点一下试试</view>
    <button class="btn btn--primary play__start" bindtap="loadLevel">再试一次</button>
  </view>

  <view wx:if="{{stage === 'ready'}}" class="card play__ready">
    <block wx:if="{{attempt.failed}}">
      <view class="play__ready-title">差一点点！</view>
      <view class="play__ready-desc">❤️ 用完啦，再来一次肯定行！{{hintTexts.keptAfterFailure}}会帮你留着</view>
    </block>
    <block wx:else>
      <view class="play__ready-title">准备好了吗？</view>
      <view class="play__ready-desc">你有 {{attempt.maxWrongAttempts}} 颗❤️，答错一次少一颗，加油！</view>
    </block>
    <button class="btn btn--primary play__start" loading="{{busy}}" bindtap="handleStart">
      {{attempt.failed ? '再来一次' : '开始挑战'}}<image class="play__cost-icon" src="/assets/icons/stamina.png" mode="aspectFit" />-{{staminaCost}}
    </button>
    <view class="play__recovery"><stamina-recovery items="{{items}}" bind:claimed="syncItems" /></view>
    <button wx:if="{{attempt.failed && sharing}}" class="btn btn--ghost play__start" bindtap="handleRescue">求助好友（免费）</button>
    <view class="play__guide-link" bindtap="openGuide">玩法说明</view>
  </view>

  <block wx:if="{{stage === 'playing'}}">
    <view class="play__hearts">
      <image wx:for="{{hearts}}" wx:key="index" class="play__heart {{item ? '' : 'play__heart--lost'}}" src="{{item ? '/assets/icons/heart-full.png' : '/assets/icons/heart-empty.png'}}" mode="aspectFit" />
    </view>
    <view class="card play__clue">
      <view class="play__clue-label">{{clueLabel}}</view>
      <view wx:if="{{gameType === 'hanzi'}}" class="play__hanzi play__hanzi--{{hanziKind}}">{{clue}}</view>
      <view wx:elif="{{gameType === 'typo'}}" class="play__typo">
        <text wx:for="{{clueChars}}" wx:key="index" class="play__typo-char {{item.wrong ? 'play__typo-char--wrong' : ''}}">{{item.char}}</text>
      </view>
      <view wx:else class="play__clue-text"><text wx:for="{{clueSegments}}" wx:key="index" class="{{item.masked ? 'clue-mask' : ''}}">{{item.text}}</text></view>
      <view wx:if="{{clueHint}}" class="play__clue-hint">释义：<text wx:for="{{clueHintSegments}}" wx:key="index" class="{{item.masked ? 'clue-mask clue-mask--small' : ''}}">{{item.text}}</text></view>
      <view wx:if="{{poemSource}}" class="play__clue-source">{{poemSource}}</view>
      <view wx:if="{{meaning}}" class="play__meaning">💡 意思：{{meaning}}</view>
    </view>

    <char-puzzle
      id="puzzle"
      board="{{board}}"
      answer-length="{{answerLength}}"
      revealed="{{revealed}}"
      eliminated="{{eliminated}}"
      answer-pinyin="{{answerPinyin}}"
      columns="{{game.boardColumns}}"
      disabled="{{submitting}}"
      checking="{{submitting}}"
      bind:complete="handleComplete"
    />

    <view class="play__actions">
      <button class="btn btn--primary play__action" loading="{{busy}}" bindtap="handleHint">
        提示（{{hintsUsed}}/{{maxHints}}）
      </button>
      <!-- 求助好友 only after a miss, so children try on their own first. -->
      <button wx:if="{{sharing && attempt.attemptsLeft < attempt.maxWrongAttempts}}" class="btn btn--ghost play__action" bindtap="handleRescue">求助好友</button>
    </view>
  </block>

  <view wx:if="{{stage === 'solved'}}" class="card play__result">
    <view class="play__result-title">答对啦！</view>
    <view class="play__result-badges">
      <view class="play__result-badge">闯过第 {{levelNo}} 关</view>
      <view wx:if="{{perfectPass}}" class="play__result-badge play__result-badge--perfect">满分过关</view>
    </view>
    <game-solution game-type="{{gameType}}" solution="{{solution}}" />
    <view wx:if="{{allCleared}}" class="play__all-cleared">
      <view class="play__all-cleared-title">全部闯过啦！</view>
      <view class="play__all-cleared-desc">新关卡正在路上～</view>
    </view>
    <view wx:if="{{titleUpgrade}}" class="play__reward play__reward--title">称号升级啦！你现在是「{{titleUpgrade}}」</view>
    <view wx:if="{{milestone && milestone.pendingChests > 0}}" class="play__reward">
      <view>解锁了 {{milestone.pendingChests}} 个宝箱</view>
      <button class="btn btn--primary play__reward-btn" loading="{{busy}}" bindtap="handleOpenChests">开宝箱</button>
    </view>
    <view wx:elif="{{milestone}}" class="play__reward-hint">
      再闯过 {{milestone.levelsToNextChest}} 关开{{milestone.nextChestIsBig ? '大' : ''}}宝箱：{{nextChestText}}
    </view>
    <view class="play__actions">
      <button class="btn btn--muted play__action" bindtap="goLevelList">关卡列表</button>
      <button wx:if="{{nextLevelNo}}" class="btn btn--primary play__action" bindtap="goNextLevel">
        下一关<image class="play__cost-icon" src="/assets/icons/stamina.png" mode="aspectFit" />-{{staminaCost}}
      </button>
      <button wx:else class="btn btn--primary play__action" bindtap="openLeaderboard">看排行榜</button>
    </view>
  </view>
</view>

<game-guide
  visible="{{guideVisible}}"
  sections="{{guideSections}}"
  confirm-text="{{guideConfirmText}}"
  bind:confirm="handleGuideConfirm"
  bind:close="handleGuideClose"
/>

<view wx:if="{{rescueSheetVisible}}" class="rescue-sheet" bindtap="closeRescueSheet">
  <view class="rescue-sheet__panel" catchtap="noop">
    <view class="rescue-sheet__title">向好友求助</view>
    <view class="rescue-sheet__desc">把这一关发给好友或群，有人答对你就直接过关，不消耗体力。</view>
    <button class="btn btn--primary" open-type="share" data-purpose="rescue">发给好友 / 群</button>
    <button class="btn btn--muted rescue-sheet__cancel" bindtap="closeRescueSheet">再想想</button>
  </view>
</view>

<practice-cheer
  visible="{{cheer.visible}}"
  title="{{cheer.title}}"
  subtitle="{{cheer.subtitle}}"
  mascot="{{cheer.mascot}}"
  big="{{cheer.big}}"
  flying-star="{{false}}"
/>

<reward-popup
  visible="{{rewardPopup.visible}}"
  title="{{rewardPopup.title}}"
  subtitle="{{rewardPopup.subtitle}}"
  badge="{{rewardPopup.badge}}"
  rewards="{{rewardPopup.rewards}}"
  double-token="{{rewardPopup.doubleToken}}"
  sound="{{rewardPopup.sound}}"
  bind:close="closeRewardPopup"
/>
