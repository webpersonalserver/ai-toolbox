.play__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.play__items {
  display: flex;
  gap: var(--space-sm);
}

.play__stage {
  display: inline-block;
  margin-bottom: var(--space-xs);
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  background: var(--game-color);
  color: var(--color-on-accent);
  font-size: var(--font-sm);
  font-weight: 700;
}

/* 汉字闯关: one big clue — a picture, a pinyin, a character, or a word with a blank. */
.play__hanzi {
  padding: var(--space-sm) 0;
  color: var(--game-color-deep);
  font-weight: 900;
  line-height: 1.3;
  text-align: center;
}

.play__hanzi--picture { font-size: 160rpx; }
.play__hanzi--pinyin { font-size: 88rpx; letter-spacing: 4rpx; }
.play__hanzi--radical { font-size: 140rpx; }
.play__hanzi--word { font-size: 110rpx; letter-spacing: 12rpx; }

.play__typo {
  display: flex;
  justify-content: center;
  margin: var(--space-sm) 0;
}

.play__typo-char {
  margin: 0 var(--space-xs);
  font-size: 72rpx;
  font-weight: 800;
}

.play__typo-char--wrong {
  color: var(--color-primary);
  text-decoration: underline wavy;
}

.play__clue-hint {
  margin-top: var(--space-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

/* 歇后语: what the saying means, so children can guess the second half from it. */
.play__meaning {
  margin-top: var(--space-sm);
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-gold-soft);
  font-size: var(--font-md);
  font-weight: 700;
}

.play__clue-source {
  margin-top: var(--space-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  text-align: right;
}

.play__level {
  font-size: var(--font-xl);
  font-weight: 800;
}


.play__clue {
  margin-bottom: var(--space-xl);
}

.play__hearts {
  display: flex;
  justify-content: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.play__heart {
  width: 52rpx;
  height: 52rpx;
  transition: transform 0.2s ease;
}

.play__heart--lost {
  transform: scale(0.85);
}

.play__ready {
  text-align: center;
}

.play__ready-title {
  font-size: var(--font-xl);
  font-weight: 800;
}

.play__ready-desc {
  margin: var(--space-sm) 0 var(--space-xl);
  color: var(--color-ink-soft);
}

.play__start + .play__start,
.play__recovery + .play__start {
  margin-top: var(--space-md);
}

.play__guide-link {
  /* A text link, but a finger-sized one. */
  display: inline-flex;
  align-items: center;
  min-height: 80rpx;
  margin-top: var(--space-sm);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
  text-decoration: underline;
}

.play__recovery {
  margin-top: var(--space-sm);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}

.play__clue-label {
  margin-bottom: var(--space-xs);
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.play__clue-text {
  font-size: var(--font-lg);
  line-height: 1.8;
}

.play__actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-xl);
}

.play__action {
  flex: 1;
}

.play__result {
  text-align: center;
  position: relative;
  overflow: hidden;
  animation: play-result-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1);
}

.play__result-title {
  margin-bottom: var(--space-sm);
  color: var(--color-success);
  font-size: var(--font-title);
  font-weight: 900;
}

.play__result-badges {
  display: flex;
  justify-content: center;
  gap: var(--space-sm);
}

.play__result-badge--perfect {
  background: var(--color-gold);
  box-shadow: 0 4rpx 0 var(--color-primary-deep);
  color: var(--color-ink);
  animation: play-perfect-stamp 0.5s cubic-bezier(0.3, 1.6, 0.5, 1) 0.4s both;
}

@keyframes play-perfect-stamp {
  0% { transform: scale(2.4) rotate(-12deg); opacity: 0; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

.play__result-badge {
  display: inline-block;
  padding: 4rpx var(--space-md);
  border-radius: 999rpx;
  background: var(--color-success-soft);
  color: var(--color-success);
  font-size: var(--font-sm);
  font-weight: 700;
}



.play__all-cleared {
  margin-top: var(--space-lg);
  padding: var(--space-lg);
  border-radius: var(--radius-md);
  background: var(--color-success-soft);
  color: var(--color-success);
}

.play__all-cleared-title {
  font-size: var(--font-lg);
  font-weight: 800;
}

.play__all-cleared-desc {
  font-size: var(--font-sm);
}

.play__reward {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-lg);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 700;
}

.play__reward--title {
  justify-content: center;
  font-size: var(--font-lg);
}

.btn.play__reward-btn {
  flex-shrink: 0;
  width: auto;
  height: 88rpx;
  margin: 0 0 0 var(--space-md);
  padding: 0 var(--space-lg);
  line-height: 88rpx;
  font-size: var(--font-sm);
  white-space: nowrap;
}

.play__reward-hint {
  margin-top: var(--space-md);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}



.rescue-sheet {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: var(--color-overlay);
  z-index: 10;
}

.rescue-sheet__panel {
  width: 100%;
  padding: var(--space-xl) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-surface);
  box-sizing: border-box;
}

.rescue-sheet__title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.rescue-sheet__desc {
  margin: var(--space-sm) 0 var(--space-lg);
  color: var(--color-ink-soft);
}

.rescue-sheet__cancel {
  margin-top: var(--space-md);
}

.play__cost-icon {
  width: 32rpx;
  height: 32rpx;
  margin: 0 2rpx 0 12rpx;
}


@keyframes play-result-pop {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 下一关 transition: the new level number swings in from the right while the next puzzle loads. */
.play__next {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  text-align: center;
}

.play__next-label {
  color: var(--game-color-deep);
  font-size: var(--font-lg);
  font-weight: 800;
  letter-spacing: 8rpx;
  animation: play-next-fade 0.4s ease-out both;
}

.play__next-level {
  margin: var(--space-md) 0;
  padding: var(--space-md) var(--space-xl);
  border-radius: var(--radius-lg);
  background: var(--game-color);
  box-shadow: 0 12rpx 0 var(--game-color-deep);
  color: var(--color-on-accent);
  font-size: 96rpx;
  font-weight: 900;
  animation: play-next-swing 0.6s cubic-bezier(0.2, 1.4, 0.4, 1) 0.1s both;
}

.play__next-go {
  color: var(--color-ink-soft);
  font-size: var(--font-lg);
  font-weight: 800;
  animation: play-next-fade 0.4s ease-out 0.45s both, play-next-bob 1s ease-in-out 0.85s infinite;
}

@keyframes play-next-swing {
  0% { transform: translateX(120%) rotate(8deg); opacity: 0; }
  100% { transform: translateX(0) rotate(0deg); opacity: 1; }
}

@keyframes play-next-fade {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes play-next-bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* 再练一次 (review): no items, hearts or hint buttons — just the puzzle and a word of encouragement. */
.play__review-tag {
  padding: 6rpx var(--space-md);
  border-radius: 999rpx;
  background: var(--game-color-soft);
  color: var(--game-color-deep);
  font-size: var(--font-sm);
  font-weight: 800;
}

.play__review-ask {
  margin-top: var(--space-md);
  font-weight: 800;
  text-align: center;
}

.play__review-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.play__review-hint {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

/* A finger-sized pill: the child flips the answer on and off as often as needed. */
.play__answer-toggle {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  min-height: 72rpx;
  padding: 0 var(--space-md);
  border-radius: 999rpx;
  background: var(--game-color-soft);
  color: var(--game-color-deep);
  font-size: var(--font-sm);
  font-weight: 800;
}

.play__review-answer {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-gold-soft);
  color: var(--color-ink);
  font-size: var(--font-lg);
  font-weight: 900;
  letter-spacing: 4rpx;
  text-align: center;
}
