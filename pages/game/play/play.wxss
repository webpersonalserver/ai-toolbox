.play__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.play__items {
  display: flex;
  gap: var(--space-sm);
}

.play__stage {
  display: inline-block;
  margin-bottom: var(--space-xs);
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  background: var(--game-color);
  color: var(--color-on-accent);
  font-size: var(--font-sm);
  font-weight: 700;
}

.play__typo {
  display: flex;
  justify-content: center;
  margin: var(--space-sm) 0;
}

.play__typo-char {
  margin: 0 var(--space-xs);
  font-size: 72rpx;
  font-weight: 800;
}

.play__typo-char--wrong {
  color: var(--color-primary);
  text-decoration: underline wavy;
}

.play__clue-hint {
  margin-top: var(--space-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.play__clue-source {
  margin-top: var(--space-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  text-align: right;
}

.play__level {
  font-size: var(--font-xl);
  font-weight: 800;
}


.play__clue {
  margin-bottom: var(--space-xl);
}

.play__hearts {
  display: flex;
  justify-content: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.play__heart {
  width: 52rpx;
  height: 52rpx;
  transition: transform 0.2s ease;
}

.play__heart--lost {
  transform: scale(0.85);
}

.play__ready {
  text-align: center;
}

.play__ready-title {
  font-size: var(--font-xl);
  font-weight: 800;
}

.play__ready-desc {
  margin: var(--space-sm) 0 var(--space-xl);
  color: var(--color-ink-soft);
}

.play__start + .play__start,
.play__recovery + .play__start {
  margin-top: var(--space-md);
}

.play__guide-link {
  margin-top: var(--space-lg);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
  text-decoration: underline;
}

.play__recovery {
  margin-top: var(--space-sm);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}

.play__clue-label {
  margin-bottom: var(--space-xs);
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 700;
  letter-spacing: 4rpx;
}

.play__clue-text {
  font-size: var(--font-lg);
  line-height: 1.8;
}

.play__actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-xl);
}

.play__action {
  flex: 1;
}

.play__result {
  text-align: center;
  position: relative;
  overflow: hidden;
  animation: play-result-pop 0.45s cubic-bezier(0.2, 1.4, 0.4, 1);
}

.play__result-badge {
  display: inline-block;
  padding: 4rpx var(--space-md);
  border-radius: 999rpx;
  background: var(--color-success-soft);
  color: var(--color-success);
  font-size: var(--font-sm);
  font-weight: 700;
}



.play__all-cleared {
  margin-top: var(--space-lg);
  padding: var(--space-lg);
  border-radius: var(--radius-md);
  background: var(--color-success-soft);
  color: var(--color-success);
}

.play__all-cleared-title {
  font-size: var(--font-lg);
  font-weight: 800;
}

.play__all-cleared-desc {
  font-size: var(--font-sm);
}

.play__reward {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-lg);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
  color: var(--color-primary);
  font-weight: 700;
}

.play__reward--title {
  justify-content: center;
  font-size: var(--font-lg);
}

.btn.play__reward-btn {
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: var(--font-sm);
}

.play__reward-hint {
  margin-top: var(--space-md);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}



.rescue-sheet {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: var(--color-overlay);
  z-index: 10;
}

.rescue-sheet__panel {
  width: 100%;
  padding: var(--space-xl) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-surface);
  box-sizing: border-box;
}

.rescue-sheet__title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.rescue-sheet__desc {
  margin: var(--space-sm) 0 var(--space-lg);
  color: var(--color-ink-soft);
}

.rescue-sheet__cancel {
  margin-top: var(--space-md);
}

.play__cost-icon {
  width: 32rpx;
  height: 32rpx;
  margin: 0 2rpx 0 12rpx;
}


@keyframes play-result-pop {
  0% { transform: scale(0.85); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.play__confetti {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
}

.play__confetti-piece {
  position: absolute;
  top: -24rpx;
  width: 16rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: var(--game-color);
  animation: play-confetti-fall 1.5s ease-in forwards;
}

.play__confetti-piece:nth-child(3n) { background: var(--color-gold); }
.play__confetti-piece:nth-child(3n + 1) { background: var(--color-success); }
.play__confetti-piece:nth-child(1) { left: 6%; animation-delay: 0s; }
.play__confetti-piece:nth-child(2) { left: 14%; animation-delay: 0.15s; }
.play__confetti-piece:nth-child(3) { left: 22%; animation-delay: 0.05s; }
.play__confetti-piece:nth-child(4) { left: 30%; animation-delay: 0.25s; }
.play__confetti-piece:nth-child(5) { left: 38%; animation-delay: 0.1s; }
.play__confetti-piece:nth-child(6) { left: 46%; animation-delay: 0.3s; }
.play__confetti-piece:nth-child(7) { left: 54%; animation-delay: 0s; }
.play__confetti-piece:nth-child(8) { left: 62%; animation-delay: 0.2s; }
.play__confetti-piece:nth-child(9) { left: 70%; animation-delay: 0.08s; }
.play__confetti-piece:nth-child(10) { left: 78%; animation-delay: 0.28s; }
.play__confetti-piece:nth-child(11) { left: 86%; animation-delay: 0.12s; }
.play__confetti-piece:nth-child(12) { left: 94%; animation-delay: 0.22s; }
.play__confetti-piece:nth-child(13) { left: 42%; animation-delay: 0.35s; }
.play__confetti-piece:nth-child(14) { left: 66%; animation-delay: 0.4s; }

@keyframes play-confetti-fall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(560rpx) rotate(540deg); opacity: 0; }
}
