.mathlv {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.mathlv__topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-md);
}

.mathlv__items {
  display: flex;
  gap: var(--space-sm);
}

.mathlv__stage {
  display: inline-block;
  margin-bottom: var(--space-xs);
  padding: 0 var(--space-sm);
  border-radius: var(--radius-sm);
  background: var(--game-color);
  color: var(--color-on-accent);
  font-size: var(--font-sm);
  font-weight: 700;
}

.mathlv__level {
  font-size: var(--font-xl);
  font-weight: 800;
}

.mathlv__center {
  margin-top: 30vh;
  color: var(--color-ink-soft);
  text-align: center;
}

.mathlv__ready {
  margin-top: var(--space-xl);
  text-align: center;
}

.mathlv__ready-title {
  font-size: var(--font-xl);
  font-weight: 900;
}

.mathlv__ready-desc {
  margin: var(--space-sm) 0 var(--space-lg);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  line-height: 1.6;
}

.mathlv__start {
  margin-top: var(--space-md);
}

.mathlv__cost-icon {
  width: 32rpx;
  height: 32rpx;
  margin: 0 4rpx 0 12rpx;
  vertical-align: -4rpx;
}

.mathlv__hearts {
  display: flex;
  justify-content: center;
  gap: var(--space-sm);
}

.mathlv__heart {
  width: 48rpx;
  height: 48rpx;
}

.mathlv__heart--lost {
  transform: scale(0.85);
}

.mathlv__dots {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin: var(--space-sm) 0;
}

.mathlv__dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: var(--color-border);
}

.mathlv__dot--done { background: var(--color-success); }
.mathlv__dot--current { background: var(--game-color); transform: scale(1.3); }

.mathlv__story {
  margin-bottom: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-gold-soft);
  font-size: var(--font-sm);
  font-weight: 700;
}

.mathlv__helper {
  display: flex;
  justify-content: center;
  min-height: 64rpx;
  margin-bottom: var(--space-sm);
}

.mathlv__hint {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  box-shadow: 0 6rpx 0 var(--color-border);
  color: var(--color-primary-deep);
  font-size: var(--font-sm);
  font-weight: 800;
}

.mathlv__hint--pressed {
  transform: translateY(6rpx);
  box-shadow: none;
}

.mathlv__shown {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: var(--color-success-soft);
  color: var(--color-success-deep);
  font-size: var(--font-sm);
  font-weight: 800;
}

.mathlv__solved {
  overflow-y: auto;
}

.mathlv__result {
  text-align: center;
}

.mathlv__result-title {
  font-size: var(--font-xl);
  font-weight: 900;
}

.mathlv__result-line {
  margin-top: 6rpx;
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.mathlv__review {
  margin-top: var(--space-md);
  text-align: left;
}

.mathlv__review-item {
  padding: 6rpx 0;
  border-bottom: 2rpx dashed var(--color-border);
  font-size: var(--font-md);
}
