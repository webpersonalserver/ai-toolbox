.levels__header {
  margin-bottom: var(--space-lg);
}

.levels__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Links are small text, so the tap area is padded out to a finger-sized 80rpx. */
.levels__links {
  display: flex;
  align-items: center;
}

.levels__link {
  display: inline-flex;
  align-items: center;
  min-height: 80rpx;
  padding: 0 var(--space-sm);
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 600;
}

.levels__summary {
  margin-top: var(--space-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.levels__chest {
  margin-top: var(--space-md);
}

.levels__stages {
  display: flex;
  margin-bottom: var(--space-md);
  white-space: nowrap;
}

.levels__stage {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  margin-right: var(--space-sm);
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.levels__stage--active {
  background: var(--game-color-soft);
  color: var(--game-color-deep);
}

.levels__stage-name {
  font-weight: 700;
}

.levels__stage-range {
  color: var(--color-ink-faint);
  font-size: 20rpx;
}

.levels__pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

/* Doubled class outranks the built-in `button:not([size=mini])` width rule. */
.btn.levels__pager-btn {
  flex-shrink: 0;
  width: 180rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: var(--font-sm);
}

.levels__pager-range {
  flex: 1;
  margin: 0 var(--space-sm);
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
}

.levels__grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--space-md);
}

.levels__cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-lg);
  font-weight: 700;
}

.levels__cell--solved {
  background: var(--color-success-soft);
  color: var(--color-success);
}

.levels__cell--current {
  background: var(--game-color);
  color: var(--color-on-accent);
  box-shadow: 0 var(--jelly-depth) 0 var(--game-color-deep);
}

.levels__cell--locked {
  background: var(--color-surface-muted);
  color: var(--color-ink-faint);
}

.levels__lock {
  font-size: var(--font-lg);
}

.levels__empty {
  text-align: center;
}

.levels__empty-title {
  font-size: var(--font-lg);
  font-weight: 800;
}

.levels__empty-desc {
  margin-top: var(--space-xs);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}
