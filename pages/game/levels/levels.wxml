<loading-skeleton wx:if="{{loading}}" rows="3" />
<view class="page levels game-theme--{{gameType}}" wx:if="{{!loading}}">
  <view class="card levels__header">
    <view class="levels__title-row">
      <view class="chip">{{titleName}}</view>
      <view class="levels__links">
        <text class="levels__link" bindtap="openLeaderboard">排行榜 ›</text>
        <text class="levels__link" bindtap="openBook">{{game.bookName}} ›</text>
      </view>
    </view>
    <view class="levels__summary">
      <text wx:if="{{allSolved}}">你已通关全部关卡，更多挑战敬请期待</text>
      <text wx:else>已通过 {{solvedCount}} 关 · {{titleProgressText}}</text>
    </view>
    <button wx:if="{{pendingChests > 0}}" class="btn btn--primary levels__chest" loading="{{openingChests}}" bindtap="handleOpenChests">
      有 {{pendingChests}} 个宝箱待打开
    </button>
  </view>

  <scroll-view wx:if="{{stages.length}}" class="levels__stages" scroll-x enable-flex>
    <view
      wx:for="{{stages}}"
      wx:key="name"
      class="levels__stage {{item.name === activeStageName ? 'levels__stage--active' : ''}}"
      data-first-level-no="{{item.firstLevelNo}}"
      bindtap="jumpToStage"
    >
      <view class="levels__stage-name">{{item.name}}</view>
      <view class="levels__stage-range">{{item.firstLevelNo}}-{{item.lastLevelNo}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{!total}}" class="card levels__empty">
    <view class="levels__empty-title">关卡正在准备中</view>
    <view class="levels__empty-desc">这个玩法的题目还没上线，先去玩玩别的吧</view>
  </view>

  <block wx:else>
  <view class="levels__pager">
    <button class="btn btn--muted levels__pager-btn" disabled="{{pageIndex === 0}}" bindtap="showPreviousPage">上一页</button>
    <view class="levels__pager-range">第 {{firstLevelNo}} - {{lastLevelNo}} 关</view>
    <button class="btn btn--muted levels__pager-btn" disabled="{{pageIndex >= pageCount - 1}}" bindtap="showNextPage">下一页</button>
  </view>

  <view class="levels__grid">
    <view
      wx:for="{{levels}}"
      wx:key="levelNo"
      class="levels__cell levels__cell--{{item.status}}"
      data-level-no="{{item.levelNo}}"
      data-status="{{item.status}}"
      bindtap="handleLevelTap"
    >
      <text wx:if="{{item.status === 'locked'}}" class="levels__lock">锁</text>
      <text wx:else>{{item.levelNo}}</text>
    </view>
  </view>
  </block>
</view>

<reward-popup
  visible="{{rewardPopup.visible}}"
  title="{{rewardPopup.title}}"
  subtitle="{{rewardPopup.subtitle}}"
  badge="{{rewardPopup.badge}}"
  rewards="{{rewardPopup.rewards}}"
  bind:close="closeRewardPopup"
/>
