.daily--center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: var(--color-ink-soft);
  box-sizing: border-box;
}

.daily__intro,
.daily__result {
  text-align: center;
}

.daily__badge {
  display: inline-block;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: var(--color-gold-soft);
  font-size: var(--font-sm);
  font-weight: 800;
}

.daily__title {
  margin-top: var(--space-sm);
  font-size: 56rpx;
  font-weight: 900;
}

.daily__rule {
  margin-top: var(--space-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  line-height: 1.6;
}

.daily__dots {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin: var(--space-lg) 0;
}

.daily__dots--small {
  margin: var(--space-sm) 0 var(--space-md);
}

.daily__dot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: var(--color-on-accent);
  font-size: 24rpx;
  font-weight: 900;
}

.daily__dot--hanzi { background: #9B7BFF; }
.daily__dot--math { background: var(--color-success); }

.daily__dot--small {
  width: 22rpx;
  height: 22rpx;
  background: var(--color-border);
}

.daily__dot--current { background: var(--color-primary); transform: scale(1.3); }
.daily__dot--right { background: var(--color-success); }
.daily__dot--wrong { background: var(--color-primary-deep); }

.daily__reward {
  margin-top: var(--space-sm);
  color: var(--color-primary-deep);
  font-size: var(--font-sm);
  font-weight: 800;
}

.daily__action {
  margin-top: var(--space-lg);
}

.daily-run {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.daily-run__top {
  display: flex;
  justify-content: space-between;
  font-weight: 800;
}

.daily-run__clock {
  color: var(--color-ink-soft);
}

.daily-run__board {
  text-align: center;
}

.daily-run__prompt {
  color: var(--color-ink-soft);
  font-size: var(--font-md);
  font-weight: 700;
}

.daily-run__clue {
  padding: var(--space-sm) 0;
  color: #7A58E0;
  font-weight: 900;
  line-height: 1.3;
}

.daily-run__clue--picture { font-size: 160rpx; }
.daily-run__clue--pinyin { font-size: 88rpx; }
.daily-run__clue--radical { font-size: 140rpx; }
.daily-run__clue--word { font-size: 110rpx; letter-spacing: 12rpx; }

.daily-run__choices {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-md);
  margin-top: auto;
  padding-bottom: env(safe-area-inset-bottom);
}

.daily-run__choice {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 150rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: 0 8rpx 0 var(--color-border);
  font-size: 72rpx;
  font-weight: 900;
}

.daily-run__choice--pressed {
  transform: translateY(8rpx);
  box-shadow: none;
}

.daily-run__choice--right {
  background: var(--color-success);
  box-shadow: 0 8rpx 0 var(--color-success-deep);
  color: var(--color-on-accent);
}

.daily-run__choice--wrong {
  background: var(--color-primary-soft);
  box-shadow: 0 8rpx 0 var(--color-primary-deep);
  color: var(--color-primary-deep);
}

.daily-run__story {
  margin-bottom: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-gold-soft);
  font-size: var(--font-sm);
  font-weight: 700;
}

.daily__score {
  margin-top: var(--space-md);
  font-size: 140rpx;
  font-weight: 900;
  line-height: 1.1;
}

.daily__score--perfect {
  color: var(--color-gold);
}

.daily__score-total {
  color: var(--color-ink-soft);
  font-size: 56rpx;
}

.daily__line {
  margin-top: var(--space-sm);
  font-size: var(--font-lg);
  font-weight: 800;
}

.daily__time,
.daily__muted {
  margin-top: 4rpx;
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.daily__missed {
  margin-top: var(--space-md);
}

.daily__missed-title {
  margin-bottom: var(--space-sm);
  font-weight: 900;
}

.daily__missed-item {
  font-size: var(--font-md);
  line-height: 1.8;
}
