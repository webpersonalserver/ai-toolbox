<view class="page leaderboard-home">
  <view wx:if="{{loadFailed}}" class="lb-home__notice" bindtap="loadSummary">📶 名次没加载出来，点我再试一次</view>

  <view wx:for="{{sections}}" wx:for-item="section" wx:key="id" class="lb-home__section">
    <view class="lb-home__title">{{section.icon}} {{section.name}}</view>
    <view wx:if="{{section.comingSoon}}" class="card lb-home__soon">正在建造中，英语玩法开放后这里就有排行榜～</view>
    <view wx:else class="lb-home__grid">
      <view
        wx:for="{{section.cards}}"
        wx:key="id"
        class="card lb-card"
        data-url="{{item.url}}"
        bindtap="openBoard"
      >
        <view class="lb-card__head">
          <text class="lb-card__icon">{{item.icon}}</text>
          <text class="lb-card__name">{{item.name}}</text>
          <text wx:if="{{item.tag}}" class="lb-card__tag">{{item.tag}}</text>
        </view>
        <view wx:if="{{loading}}" class="lb-card__rank lb-card__rank--loading">加载中…</view>
        <view wx:elif="{{loadFailed}}" class="lb-card__rank lb-card__rank--loading">名次 —</view>
        <block wx:else>
          <view class="lb-card__rank {{item.onPodium ? 'lb-card__rank--podium' : ''}}">{{item.rankText}}</view>
          <view class="lb-card__detail">{{item.detail}}</view>
        </block>
      </view>
    </view>
  </view>
</view>
