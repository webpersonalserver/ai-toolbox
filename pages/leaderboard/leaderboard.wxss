/* Subject tabs (汉字城堡 / 数字星球 / 字母乐园) on top, the subject's boards as chips below — the same split as the lobby. */
.lb-subjects {
  display: flex;
  gap: 8rpx;
  margin: var(--space-md) var(--space-lg) 0;
  padding: 6rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface-muted);
}

.lb-subjects__tab {
  flex: 1;
  padding: var(--space-sm) 0;
  border-radius: var(--radius-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-md);
  font-weight: 800;
  text-align: center;
}

.lb-subjects__tab--active {
  background: var(--color-surface);
  box-shadow: 0 4rpx 0 var(--color-border);
  color: var(--color-primary-deep);
}

/* Boards wrap onto a second row rather than scrolling, so every board can be seen at once. */
.lb-boards {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-md);
  padding: 0 var(--space-lg);
}

.lb-boards--islands {
  margin-top: var(--space-sm);
}

.lb-boards__chip {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--color-surface);
  box-shadow: 0 4rpx 0 var(--color-border);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  font-weight: 800;
}

.lb-boards__chip--small {
  height: 48rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
}

.lb-boards__chip--active {
  background: var(--color-primary);
  box-shadow: 0 4rpx 0 var(--color-primary-deep);
  color: var(--color-on-accent);
}

.leaderboard {
  padding-bottom: 200rpx;
}

.leaderboard__summary {
  margin-bottom: var(--space-md);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.leaderboard__empty {
  color: var(--color-ink-soft);
  text-align: center;
}

.leaderboard__empty-title {
  margin-bottom: var(--space-xs);
  color: var(--color-ink);
  font-size: var(--font-lg);
  font-weight: 800;
}

.leaderboard__open-seats {
  margin-top: var(--space-md);
  background: var(--color-gold-soft);
  color: var(--color-primary-deep);
  font-weight: 800;
  text-align: center;
}

.leaderboard__row {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-sm);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-surface);
}

.leaderboard__row--me {
  background: var(--color-primary-soft);
}

.leaderboard__rank {
  width: 64rpx;
  color: var(--color-ink-soft);
  font-size: var(--font-lg);
  font-weight: 800;
  text-align: center;
}

.leaderboard__rank--podium {
  color: var(--color-gold);
}

.leaderboard__avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin: 0 var(--space-md) 0 var(--space-sm);
  border-radius: 50%;
}

.leaderboard__avatar--empty {
  background: var(--color-surface-muted);
  color: var(--color-ink-faint);
  font-weight: 700;
}

.leaderboard__body {
  flex: 1;
  min-width: 0;
}

.leaderboard__name {
  overflow: hidden;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.leaderboard__me-tag {
  margin-left: var(--space-xs);
  padding: 0 var(--space-xs);
  border-radius: var(--radius-sm);
  background: var(--color-primary);
  color: var(--color-on-accent);
  font-size: 20rpx;
}

.leaderboard__title {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.leaderboard__score {
  color: var(--color-primary);
  font-size: var(--font-lg);
  font-weight: 800;
}

.leaderboard__unit {
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
  font-weight: 400;
}

.leaderboard__mine {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  padding: var(--space-sm) var(--space-lg);
  background: var(--color-bg);
  box-shadow: 0 -6rpx 24rpx var(--color-shadow);
}

.leaderboard__mine .leaderboard__row {
  margin-bottom: 0;
}
