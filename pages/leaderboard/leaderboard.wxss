/* Cards two to a row under each subject title; the spacing follows the lobby (cards var(--space-md) apart). */
.lb-home__notice {
  margin-bottom: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-gold-soft);
  color: var(--color-primary-deep);
  font-size: var(--font-sm);
  font-weight: 800;
  text-align: center;
}

.lb-home__section + .lb-home__section {
  margin-top: var(--space-lg);
}

.lb-home__title {
  margin-bottom: var(--space-md);
  font-size: var(--font-lg);
  font-weight: 900;
}

.lb-home__soon {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  text-align: center;
}

.lb-home__grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}

.lb-card {
  box-sizing: border-box;
  width: calc((100% - var(--space-md)) / 2);
  min-width: 0;
}

.lb-card__head {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.lb-card__icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  font-size: var(--font-sm);
  font-weight: 900;
}

.lb-card__name {
  overflow: hidden;
  font-size: var(--font-md);
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lb-card__tag {
  flex-shrink: 0;
  margin-left: auto;
  padding: 0 var(--space-xs);
  border-radius: var(--radius-sm);
  background: var(--color-gold-soft);
  color: var(--color-primary-deep);
  font-size: 20rpx;
  font-weight: 800;
}

.lb-card__rank {
  margin-top: var(--space-sm);
  color: var(--color-primary);
  font-size: var(--font-md);
  font-weight: 900;
}

.lb-card__rank--podium {
  color: var(--color-gold);
}

.lb-card__rank--loading {
  color: var(--color-ink-faint);
  font-weight: 700;
}

.lb-card__detail {
  overflow: hidden;
  margin-top: 4rpx;
  color: var(--color-ink-soft);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
