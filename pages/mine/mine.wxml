<view class="page mine">
  <view class="card mine__profile">
    <button class="mine__avatar-btn" open-type="chooseAvatar" bind:chooseavatar="handleChooseAvatar">
      <image wx:if="{{avatarUrl}}" class="mine__avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="mine__avatar mine__avatar--empty">头像</view>
    </button>
    <input
      class="mine__nickname"
      type="nickname"
      value="{{nickname}}"
      placeholder="点击设置昵称"
      maxlength="20"
      bindinput="handleNicknameInput"
      bindblur="handleNicknameInput"
    />
    <button wx:if="{{profileDirty}}" class="btn btn--primary mine__save" loading="{{saving}}" bindtap="saveProfile">保存</button>
  </view>

  <view class="card mine__title">
    <view class="mine__title-row">
      <view>
        <view class="mine__hints-label">猜成语段位</view>
        <view class="mine__title-name">{{titleName}}</view>
      </view>
      <button class="btn btn--ghost mine__share" open-type="share">晒一晒</button>
    </view>
    <view class="mine__title-progress">已通过 {{solvedCount}} 关 · {{titleProgressText}}</view>
    <view class="mine__book" bindtap="openBook">我的成语本 ›</view>
  </view>

  <view class="card mine__hints">
    <view class="mine__hints-row">
      <view class="mine__stat">
        <view class="mine__hints-label">体力</view>
        <view class="mine__hints-count">{{items.stamina}}</view>
        <view wx:if="{{staminaRecoveryText}}" class="mine__recovery">{{staminaRecoveryText}}</view>
      </view>
      <view class="mine__stat">
        <view class="mine__hints-label">提示</view>
        <view class="mine__hints-count">{{items.hint}}</view>
      </view>
    </view>
    <button class="btn {{checkedIn ? 'btn--muted' : 'btn--primary'}} mine__checkin" disabled="{{checkedIn}}" bindtap="handleCheckin">
      {{checkedIn ? '今日已打卡' : '打卡领奖励'}}
    </button>
    <view class="mine__rules">
      <view wx:for="{{ruleLines}}" wx:key="index" class="mine__rule">· {{item}}</view>
    </view>
  </view>

  <view wx:if="{{isAdmin}}" class="card mine__admin" bindtap="openAdminStats">
    <view class="mine__admin-title">数据统计</view>
    <view class="mine__admin-desc">通关率、最近通关、每日趋势 ›</view>
  </view>

  <view class="mine__openid" bindlongpress="copyOpenid">用户编号：{{openid}}（长按复制）</view>
</view>
