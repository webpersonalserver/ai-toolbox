<view class="page mine">
  <view class="card mine__profile">
    <view class="mine__identity-row" hover-class="mine__profile--pressed" bindtap="openProfileEditor" bindlongpress="copyOpenid">
      <image class="mine__avatar" src="{{avatarDisplay}}" mode="aspectFill" />
      <view class="mine__identity">
        <view class="mine__nickname {{nickname ? '' : 'mine__nickname--empty'}}">{{nicknameDisplay}}</view>
        <view class="mine__edit">编辑资料 ›</view>
      </view>
    </view>
    <view class="mine__items">
      <item-chip item-type="stamina" value="{{items.stamina}}" />
      <item-chip item-type="hint" value="{{items.hint}}" />
      <stamina-recovery items="{{items}}" />
    </view>
  </view>

  <view class="card mine__title">
    <view class="mine__section-label">我的段位</view>
    <view wx:if="{{!titlesExpanded}}" class="mine__title-summary" bindtap="toggleTitles">
      <view wx:for="{{gameTitles}}" wx:key="gameType" class="mine__title-tag game-theme--{{item.gameType}}">
        <text class="mine__title-tag-icon">{{item.icon}}</text>
        <text class="mine__title-tag-name">{{item.titleName}}</text>
      </view>
    </view>
    <block wx:else>
      <!-- The whole row opens the game's 复习本 (口算闯关 has none: its level list instead). -->
      <view
        wx:for="{{gameTitles}}"
        wx:key="gameType"
        class="mine__game game-theme--{{item.gameType}}"
        hover-class="mine__game--pressed"
        data-game-type="{{item.gameType}}"
        bindtap="openBook"
      >
        <view class="mine__game-main">
          <view class="mine__game-name">{{item.name}}</view>
          <view class="mine__title-name">{{item.titleName}}</view>
          <view class="mine__title-progress">已通过 {{item.solvedCount}} 关 · {{item.titleProgressText}}</view>
        </view>
        <view wx:if="{{!item.hasReviewBook}}" class="mine__book">去闯关 ›</view>
        <view wx:elif="{{item.reviewCount}}" class="mine__book">复习 {{item.reviewCount}} 题 ›</view>
        <view wx:else class="mine__book mine__book--done">没有要复习的 ›</view>
      </view>
    </block>
    <view class="mine__title-toggle" bindtap="toggleTitles">
      <text>{{titlesExpanded ? '收起' : '展开详情'}}</text>
      <view class="chevron {{titlesExpanded ? 'chevron--up' : ''}}"></view>
    </view>
  </view>

  <view class="card mine__menu">
    <view class="mine__cell" hover-class="mine__cell--pressed" bindtap="openWelfare">
      <view>
        <text>福利袋</text>
        <text class="mine__cell-hint">做任务赚体力和提示</text>
      </view>
      <view class="mine__cell-side">
        <text wx:if="{{unclaimedWelfare > 0}}" class="mine__badge">{{unclaimedWelfare}}</text>
        <text class="mine__cell-arrow">›</text>
      </view>
    </view>
    <view class="mine__cell" hover-class="mine__cell--pressed" bindtap="openRules">
      <text>游戏规则</text>
      <text class="mine__cell-arrow">›</text>
    </view>
    <button wx:if="{{sharing}}" class="mine__cell mine__cell-button" hover-class="mine__cell--pressed" open-type="share">
      <text>晒一晒我的段位</text>
      <text class="mine__cell-arrow">›</text>
    </button>
    <view wx:if="{{isAdmin}}" class="mine__cell" hover-class="mine__cell--pressed" bindtap="openAdminStats">
      <text>数据统计</text>
      <text class="mine__cell-arrow">›</text>
    </view>
    <view wx:if="{{isAdmin}}" class="mine__cell" hover-class="mine__cell--pressed" bindtap="openAdminControl">
      <text>控制中心</text>
      <text class="mine__cell-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{isAdmin}}" class="mine__openid" bindlongpress="copyOpenid">用户编号 {{openid}} · 长按复制</view>
</view>

<game-guide
  visible="{{rulesVisible}}"
  title="游戏规则"
  sections="{{ruleSections}}"
  bind:confirm="closeRules"
  bind:close="closeRules"
/>

<profile-editor
  visible="{{editorVisible}}"
  avatar-url="{{avatarUrl}}"
  nickname="{{nickname}}"
  bind:saved="handleProfileSaved"
  bind:cancel="closeProfileEditor"
/>
