/* pages/mine/mine.wxss */
.user-title { font-size: 32rpx; font-weight: 600; }
.quota { color: #6B7280; margin-top: 12rpx; display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.expire { font-size: 22rpx; color: #9CA3AF; }
.member-tag {
  background: #F59E0B; color: #fff; font-size: 22rpx;
  padding: 4rpx 12rpx; border-radius: 12rpx; font-weight: 600;
}
.vip-card {
  background: linear-gradient(135deg, #F59E0B, #F97316);
  color: #fff;
}
.vip-title { font-size: 34rpx; font-weight: 700; }
.vip-desc { font-size: 24rpx; opacity: 0.9; margin-top: 10rpx; }
.vip-cta { font-size: 26rpx; margin-top: 16rpx; opacity: 0.95; }
.menu-item {
  display: flex; justify-content: space-between; align-items: center;
}
.arrow { color: #C7CAD1; font-size: 36rpx; }