.mine__profile,
.mine__title,
.mine__menu {
  margin-bottom: var(--space-md);
}

.mine__identity-row {
  display: flex;
  align-items: center;
}

.mine__identity {
  flex: 1;
  min-width: 0;
}

.mine__edit {
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}

.mine__items {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--color-border);
}


.mine__section-label {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  font-weight: 700;
}

.mine__menu {
  padding-top: var(--space-xs);
  padding-bottom: var(--space-xs);
}

.mine__cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) 0;
  font-size: var(--font-md);
  font-weight: 600;
}

.mine__cell + .mine__cell {
  border-top: 2rpx solid var(--color-border);
}

/* Doubled class strips the built-in button look so the share entry reads as a plain row. */
.mine__cell-button.mine__cell-button {
  width: auto;
  margin: 0;
  padding: var(--space-md) 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-ink);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: inherit;
  text-align: left;
}

.mine__cell-button::after {
  border: none;
}

.mine__cell--pressed {
  opacity: 0.6;
}

.mine__cell-arrow {
  color: var(--color-ink-faint);
}

.mine__openid {
  margin-top: var(--space-lg);
  color: var(--color-ink-faint);
  font-size: 20rpx;
  text-align: center;
  word-break: break-all;
}

.mine__profile--pressed {
  opacity: 0.85;
}

.mine__avatar {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  margin-right: var(--space-md);
  border-radius: 50%;
  background: var(--color-primary-soft);
}

.mine__nickname {
  overflow: hidden;
  font-size: var(--font-lg);
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mine__nickname--empty {
  color: var(--color-ink-faint);
}

.mine__title-name {
  color: var(--game-color-deep);
  font-size: var(--font-xl);
  font-weight: 800;
  line-height: 1.3;
}

.mine__title-progress {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.mine__title-summary {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-top: var(--space-md);
}

.mine__title-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 18rpx 4rpx 6rpx;
  border-radius: 999rpx;
  background: var(--game-color-soft);
}

.mine__title-tag-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: var(--game-color);
  color: var(--color-on-accent);
  font-size: 22rpx;
  font-weight: 800;
}

.mine__title-tag-name {
  color: var(--game-color-deep);
  font-size: var(--font-sm);
  font-weight: 800;
}

.mine__title-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: var(--space-md);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}

.mine__game {
  display: flex;
  align-items: center;
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--color-border);
}

.mine__game-main {
  flex: 1;
}

.mine__game-name {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.mine__book {
  color: var(--game-color-deep);
  font-size: var(--font-sm);
  font-weight: 600;
}

.mine__cell-side {
  display: flex;
  align-items: center;
}

.mine__badge {
  min-width: 36rpx;
  height: 36rpx;
  margin-right: var(--space-sm);
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-on-accent);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 36rpx;
  text-align: center;
  box-sizing: border-box;
}

.mine__cell-hint {
  margin-left: var(--space-sm);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}
