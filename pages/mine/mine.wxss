.mine__profile {
  display: flex;
  align-items: center;
  margin-bottom: var(--space-lg);
}

.mine__avatar-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  margin: 0 var(--space-md) 0 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
}

.mine__avatar-btn::after {
  border: none;
}

.mine__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}

.mine__avatar--empty {
  background: var(--color-surface-muted);
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}

.mine__nickname {
  flex: 1;
  font-size: var(--font-lg);
  font-weight: 700;
}

.mine__save {
  width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: var(--font-sm);
}

.mine__title {
  margin-bottom: var(--space-lg);
}

.mine__title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mine__title-name {
  color: var(--color-primary);
  font-size: var(--font-title);
  font-weight: 800;
  line-height: 1.3;
}

.mine__share {
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: var(--font-sm);
}

.mine__title-progress {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.mine__book {
  margin-top: var(--space-md);
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--color-border);
  color: var(--color-primary);
  font-weight: 600;
}

.mine__hints-row {
  display: flex;
  margin-bottom: var(--space-lg);
}

.mine__stat {
  flex: 1;
}

.mine__recovery {
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
}

.mine__hints-label {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.mine__hints-count {
  color: var(--color-primary);
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1.2;
}


.mine__admin {
  margin-top: var(--space-lg);
}

.mine__admin-title {
  font-weight: 700;
}

.mine__admin-desc {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.mine__openid {
  margin-top: var(--space-xl);
  color: var(--color-ink-faint);
  font-size: 20rpx;
  text-align: center;
  word-break: break-all;
}

.mine__rules {
  margin-top: var(--space-lg);
  padding-top: var(--space-md);
  border-top: 2rpx solid var(--color-border);
}

.mine__rule {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}
