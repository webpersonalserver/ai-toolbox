.kr {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-lg);
  background: var(--color-overlay);
  animation: kr-fade 0.3s ease-out;
}

.kr__rays {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 1400rpx;
  height: 1400rpx;
  margin: -700rpx 0 0 -700rpx;
  background: repeating-conic-gradient(var(--color-gold) 0deg 10deg, transparent 10deg 30deg);
  border-radius: 50%;
  opacity: 0.25;
  animation: kr-spin 12s linear infinite;
}

.kr--fail .kr__rays {
  display: none;
}

.kr__panel {
  position: relative;
  width: 100%;
  padding: var(--space-xl) var(--space-lg);
  border: 6rpx solid var(--color-ink);
  border-radius: var(--radius-lg);
  background: var(--color-surface);
  box-shadow: 0 16rpx 0 var(--color-ink);
  text-align: center;
  box-sizing: border-box;
  animation: kr-pop 0.6s cubic-bezier(0.2, 1.6, 0.4, 1);
}

.kr--grandmaster .kr__panel {
  border-color: var(--color-gold);
  background: var(--color-gold-soft);
  box-shadow: 0 16rpx 0 var(--color-primary-deep), 0 0 80rpx var(--color-gold);
}

.kr__heading {
  color: var(--color-ink-soft);
  font-size: var(--font-md);
  font-weight: 800;
  letter-spacing: 8rpx;
}

.kr__title {
  margin-top: var(--space-sm);
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.kr__title--grandmaster {
  color: var(--color-primary-deep);
  font-size: var(--font-xl);
}

.kr__subtitle {
  margin-top: var(--space-sm);
  color: var(--color-primary-deep);
  font-size: var(--font-lg);
  font-weight: 800;
}

.kr__stars {
  margin-top: var(--space-md);
}

.kr__star {
  display: inline-block;
  margin: 0 8rpx;
  color: var(--color-border);
  font-size: 96rpx;
}

.kr__star--earned {
  color: var(--color-gold);
  text-shadow: 0 6rpx 0 var(--color-primary-deep);
  animation: kr-star 0.5s cubic-bezier(0.2, 1.8, 0.4, 1) both;
}

.kr__star--1 { animation-delay: 0.4s; }
.kr__star--2 { animation-delay: 0.7s; }
.kr__star--3 { animation-delay: 1s; }

.kr__lines {
  margin-top: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-surface-muted);
  color: var(--color-ink);
  font-size: var(--font-md);
  line-height: 1.8;
}

.kr__actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
}

.kr__action.btn {
  width: 100%;
}

.kr__scroll {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.kr__scroll-rod {
  width: 88%;
  height: 28rpx;
  border-radius: 999rpx;
  background: var(--color-primary-deep);
}

.kr__scroll-body {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 76%;
  padding: var(--space-md) 0;
  background: var(--color-surface);
  overflow: hidden;
  animation: kr-unroll 0.9s ease-out both;
}

.kr__big-character {
  font-size: 120rpx;
  font-weight: 900;
  line-height: 1.15;
  color: var(--color-ink);
  animation: kr-ink 0.5s ease-out both;
}

.kr__big-character--0 { animation-delay: 0.8s; }
.kr__big-character--1 { animation-delay: 1.1s; }
.kr__big-character--2 { animation-delay: 1.4s; }
.kr__big-character--3 { animation-delay: 1.7s; }

.kr__seal {
  position: absolute;
  right: 20rpx;
  bottom: 30rpx;
  padding: 8rpx 10rpx;
  border: 4rpx solid var(--color-primary-deep);
  border-radius: 8rpx;
  color: var(--color-primary-deep);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
  transform: rotate(-12deg);
  animation: kr-stamp 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) 2.2s both;
}

@keyframes kr-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes kr-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes kr-pop {
  0% { transform: scale(0.5); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes kr-star {
  0% { transform: scale(0) rotate(-90deg); }
  100% { transform: scale(1) rotate(0deg); }
}

@keyframes kr-unroll {
  from { max-height: 0; }
  to { max-height: 900rpx; }
}

@keyframes kr-ink {
  0% { transform: scale(2.4); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

@keyframes kr-stamp {
  0% { transform: rotate(-12deg) scale(3); opacity: 0; }
  100% { transform: rotate(-12deg) scale(1); opacity: 1; }
}
