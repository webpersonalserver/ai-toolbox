<view wx:if="{{question}}" class="kq {{plain ? 'kq--plain' : ''}}">
  <view class="card kq__board kq__board--{{state}}">
    <block wx:if="{{question.type === 'verse'}}">
      <view class="kq__verse-label">接口诀</view>
      <view class="kq__verse">
        <text class="kq__verse-head">{{question.head}}</text>
        <view class="kq__blank kq__blank--verse kq__blank--{{state}}">
          <text wx:if="{{input}}">{{input}}</text>
          <text wx:else class="kq__blank-mark">？</text>
        </view>
      </view>
    </block>
    <view wx:else class="kq__equation {{compact ? 'kq__equation--compact' : ''}}">
      <block wx:for="{{tokens}}" wx:key="index">
        <view wx:if="{{item.kind === 'blank'}}" class="kq__blank kq__blank--{{state}}">
          <text wx:if="{{input}}">{{input}}</text>
          <text wx:else class="kq__blank-mark">?</text>
        </view>
        <view wx:else class="kq__value kq__value--{{item.kind}}">{{item.text}}</view>
      </block>
    </view>
    <view wx:if="{{state === 'revealed'}}" class="kq__reveal">{{question.revealText}}</view>
  </view>

  <view wx:if="{{question.choices}}" class="kq__choices {{question.type === 'verse' ? '' : 'kq__choices--row'}}">
    <view
      wx:for="{{question.choices}}"
      wx:key="*this"
      class="kq__choice {{pickedChoice === item ? 'kq__choice--' + state : ''}} {{locked ? 'kq__key--locked' : ''}}"
      hover-class="kq__key--pressed"
      data-choice="{{item}}"
      bindtap="pickChoice"
    >{{item}}</view>
  </view>
  <view wx:else class="kq__keypad">
    <view
      wx:for="{{keypad}}"
      wx:key="*this"
      class="kq__key kq__key--{{item}} {{locked ? 'kq__key--locked' : ''}}"
      hover-class="kq__key--pressed"
      data-key="{{item}}"
      bindtap="handleKey"
    >
      <text wx:if="{{item === 'delete'}}">⌫</text>
      <text wx:elif="{{item === 'confirm'}}">{{confirmText}}</text>
      <text wx:else>{{item}}</text>
    </view>
  </view>
</view>
