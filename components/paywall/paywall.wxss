.mask {
  position: fixed; inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex; align-items: flex-end;
  z-index: 999;
}
.card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 56rpx 32rpx 64rpx;
  box-sizing: border-box;
}
.title {
  font-size: 40rpx; font-weight: 600; text-align: center; color: #222;
}
.sub {
  font-size: 26rpx; color: #888; text-align: center; margin: 12rpx 0 40rpx;
}
.plans {
  display: flex; gap: 16rpx; margin-bottom: 40rpx;
}
.plan {
  flex: 1;
  border: 2rpx solid #eee;
  border-radius: 20rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  position: relative;
  background: #fafafa;
}
.plan-featured {
  border-color: #4F46E5;
  background: #f1f0ff;
}
.badge {
  position: absolute; top: -18rpx; right: -10rpx;
  background: #4F46E5; color: #fff;
  font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 16rpx;
}
.plan-name { font-size: 28rpx; color: #333; margin-bottom: 16rpx; }
.plan-price { font-size: 40rpx; color: #4F46E5; font-weight: 700; margin-bottom: 10rpx; }
.plan-desc { font-size: 22rpx; color: #888; line-height: 1.4; }
.close {
  text-align: center; color: #999; font-size: 28rpx; margin-top: 16rpx;
}