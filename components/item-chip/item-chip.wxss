.item-chip {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 18rpx 4rpx 10rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  box-shadow: 0 4rpx 0 var(--color-border);
}

.item-chip__icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 6rpx;
}

.item-chip__value {
  color: var(--color-ink);
  font-size: var(--font-md);
  font-weight: 800;
}

.item-chip--large {
  padding: 8rpx 28rpx 8rpx 16rpx;
}

.item-chip--large .item-chip__icon {
  width: 56rpx;
  height: 56rpx;
}

.item-chip--large .item-chip__value {
  font-size: var(--font-xl);
}
