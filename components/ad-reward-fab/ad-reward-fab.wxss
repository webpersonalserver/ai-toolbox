.ad-fab {
  position: fixed;
  right: var(--space-lg);
  bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
  /* Above the page, below every popup and sheet (welcome panel 20, reward popup 45). */
  z-index: 15;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 8rpx 0 var(--color-primary-deep), 0 12rpx 32rpx var(--color-shadow);
  color: var(--color-on-accent);
  animation: ad-fab-wiggle 3s ease-in-out infinite;
}

.ad-fab--pressed {
  transform: translateY(8rpx);
  box-shadow: none;
}

.ad-fab__icon {
  font-size: 40rpx;
  line-height: 1;
}

.ad-fab__text {
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.25;
}

.ad-sheet {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: var(--color-overlay);
}

.ad-sheet__panel {
  width: 100%;
  padding: var(--space-lg) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--color-surface);
  box-sizing: border-box;
  animation: ad-sheet-up 0.25s ease-out;
}

.ad-sheet__title {
  margin-bottom: var(--space-md);
  font-size: var(--font-lg);
  font-weight: 900;
  text-align: center;
}

.ad-sheet__offer {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-gold-soft);
}

.ad-sheet__offer--pressed {
  opacity: 0.85;
}

.ad-sheet__icon {
  width: 72rpx;
  height: 72rpx;
}

.ad-sheet__body {
  flex: 1;
}

.ad-sheet__reward {
  font-size: var(--font-lg);
  font-weight: 900;
}

.ad-sheet__remaining {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.btn.ad-sheet__go {
  height: 68rpx;
  margin: 0;
  line-height: 68rpx;
  font-size: var(--font-sm);
}

.ad-sheet__cancel {
  padding-top: var(--space-sm);
  color: var(--color-ink-soft);
  text-align: center;
}

@keyframes ad-fab-wiggle {
  0%, 84%, 100% { transform: rotate(0deg); }
  88% { transform: rotate(-12deg); }
  92% { transform: rotate(12deg); }
  96% { transform: rotate(-6deg); }
}

@keyframes ad-sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
