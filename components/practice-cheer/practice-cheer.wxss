.cheer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 40;
  overflow: hidden;
  pointer-events: none;
}

.cheer__flash {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: radial-gradient(circle at 50% 42%, var(--color-gold-soft) 0%, transparent 70%);
  animation: cheer-anim-flash 1.2s ease-out forwards;
}

.cheer--big .cheer__flash {
  background: radial-gradient(circle at 50% 42%, var(--color-gold) 0%, var(--color-gold-soft) 40%, transparent 80%);
  animation-duration: 2.4s;
}

.cheer__sun {
  position: absolute;
  top: 42%;
  left: 50%;
  width: 0;
  height: 0;
  animation: cheer-anim-spin 6s linear infinite, cheer-anim-fade-in 0.4s ease-out;
}

.cheer__ray {
  position: absolute;
  top: -600rpx;
  left: -36rpx;
  width: 72rpx;
  height: 600rpx;
  transform-origin: 50% 100%;
  background: linear-gradient(to top, var(--color-gold), transparent);
  opacity: 0.35;
  clip-path: polygon(50% 100%, 0 0, 100% 0);
}

.cheer--big .cheer__ray {
  opacity: 0.6;
}

.cheer__burst {
  position: absolute;
  top: 42%;
  left: 50%;
  width: 0;
  height: 0;
}

.cheer__spark-arm {
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  height: 0;
}

.cheer__spark {
  position: absolute;
  top: -16rpx;
  left: -16rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  animation: cheer-anim-spark 0.8s ease-out forwards;
}

.cheer--big .cheer__spark {
  width: 44rpx;
  height: 44rpx;
}

.cheer__center {
  position: absolute;
  top: 42%;
  left: 0;
  right: 0;
  padding: 0 var(--space-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(-60%);
}

.cheer__mascot {
  font-size: 120rpx;
  line-height: 1.1;
  animation: cheer-anim-mascot 0.9s cubic-bezier(0.2, 1.8, 0.4, 1);
}

.cheer--big .cheer__mascot {
  font-size: 160rpx;
  animation: cheer-anim-mascot 0.9s cubic-bezier(0.2, 1.8, 0.4, 1), cheer-anim-wiggle 0.5s ease-in-out 0.9s 3;
}

.cheer__title {
  /* Long titles (晋升「…」！) wrap inside the pill instead of running to the screen edge. */
  max-width: 100%;
  margin-top: var(--space-sm);
  padding: var(--space-sm) var(--space-xl);
  border-radius: 56rpx;
  background: var(--color-success);
  box-shadow: 0 12rpx 0 var(--color-success-deep);
  box-sizing: border-box;
  color: var(--color-on-accent);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: 2rpx;
  text-align: center;
  animation: cheer-pop 0.6s cubic-bezier(0.2, 1.8, 0.4, 1) 0.08s both;
}

.cheer--big .cheer__title {
  background: var(--color-gold);
  box-shadow: 0 14rpx 0 var(--color-primary-deep);
  color: var(--color-ink);
  font-size: 60rpx;
}

.cheer__subtitle {
  max-width: 100%;
  margin-top: var(--space-lg);
  padding: var(--space-xs) var(--space-lg);
  box-sizing: border-box;
  text-align: center;
  border-radius: 999rpx;
  background: var(--color-surface);
  box-shadow: 0 6rpx 0 var(--color-border);
  color: var(--color-primary-deep);
  font-size: var(--font-lg);
  font-weight: 800;
  animation: cheer-anim-rise 0.5s ease-out 0.3s both;
}

.cheer__confetti {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
}

.cheer__piece {
  position: absolute;
  top: -40rpx;
  width: 18rpx;
  height: 30rpx;
  animation-name: cheer-anim-confetti;
  animation-timing-function: ease-in;
  animation-fill-mode: both;
}

.cheer--big .cheer__piece {
  width: 24rpx;
  height: 38rpx;
}

.cheer__flying-star {
  position: absolute;
  font-size: 72rpx;
  animation: cheer-anim-star-fly 1.2s cubic-bezier(0.5, 0, 0.3, 1) 0.3s both;
}

@keyframes cheer-anim-flash {
  0% { opacity: 0; }
  15% { opacity: 1; }
  100% { opacity: 0.4; }
}

@keyframes cheer-anim-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes cheer-anim-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes cheer-anim-spark {
  0% { transform: translateY(0) rotate(45deg) scale(0.3); opacity: 1; }
  70% { opacity: 1; }
  100% { transform: translateY(-360rpx) rotate(225deg) scale(1); opacity: 0; }
}

@keyframes cheer-anim-mascot {
  0% { transform: scale(0) rotate(-30deg); }
  60% { transform: scale(1.3) rotate(10deg); }
  100% { transform: scale(1) rotate(0deg); }
}

@keyframes cheer-pop {
  0% { transform: scale(0.2) rotate(-8deg); opacity: 0; }
  60% { transform: scale(1.15) rotate(3deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

@keyframes cheer-anim-rise {
  from { transform: translateY(30rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes cheer-anim-confetti {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(110vh) rotate(720deg); opacity: 0.8; }
}

@keyframes cheer-anim-star-fly {
  0% { top: 30%; left: 46%; transform: scale(0.4); opacity: 0; }
  20% { top: 26%; left: 46%; transform: scale(1.6); opacity: 1; }
  100% { top: 70rpx; left: 180rpx; transform: scale(0.5); opacity: 0; }
}

@keyframes cheer-anim-wiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-12deg); }
  75% { transform: rotate(12deg); }
}
