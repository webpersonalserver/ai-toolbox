.stamina-recovery {
  display: inline-flex;
  align-items: center;
  gap: var(--space-sm);
}

.stamina-recovery__claim {
  display: inline-flex;
  align-items: center;
  margin-bottom: 6rpx;
  /* A finger-sized pill: children tap it, so it is at least 72rpx tall. */
  min-height: 72rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: var(--color-primary);
  box-shadow: 0 6rpx 0 var(--color-primary-deep);
  color: var(--color-on-accent);
  font-size: var(--font-sm);
  font-weight: 800;
  animation: stamina-recovery-breathe 1.6s ease-in-out infinite;
}

.stamina-recovery__claim--pressed {
  transform: translateY(6rpx);
  box-shadow: none;
}

.stamina-recovery__icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 4rpx;
}

.stamina-recovery__countdown {
  color: var(--color-ink-faint);
  font-size: var(--font-sm);
  font-variant-numeric: tabular-nums;
}

@keyframes stamina-recovery-breathe {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}
