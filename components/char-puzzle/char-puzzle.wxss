.char-puzzle__slots {
  display: flex;
  justify-content: center;
  gap: var(--space-md);
  margin-bottom: var(--space-sm);
}

.char-puzzle__cell {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 拼音辅助: the syllable sits right above its cell. */
.char-puzzle__pinyin {
  margin-bottom: 4rpx;
  color: var(--color-ink-soft);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.char-puzzle__slots--small .char-puzzle__pinyin {
  font-size: 22rpx;
}

.char-puzzle__slots--wrong {
  animation: char-puzzle-shake 0.4s ease-in-out;
}

.char-puzzle__slot {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border: 4rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-surface);
  font-size: var(--font-title);
  font-weight: 700;
}

.char-puzzle__slots--medium {
  gap: var(--space-sm);
}

.char-puzzle__slots--medium .char-puzzle__slot {
  width: 112rpx;
  height: 112rpx;
  font-size: var(--font-xl);
}

.char-puzzle__slots--small {
  gap: var(--space-xs);
}

.char-puzzle__slots--small .char-puzzle__slot {
  width: 88rpx;
  height: 96rpx;
  font-size: 40rpx;
}

.char-puzzle__slot--filled {
  border-style: solid;
  border-color: var(--color-ink);
}

.char-puzzle__slot--locked {
  border-style: solid;
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
  color: var(--color-primary);
}

.char-puzzle__slots--wrong .char-puzzle__slots--medium {
  gap: var(--space-sm);
}

.char-puzzle__slots--medium .char-puzzle__slot {
  width: 112rpx;
  height: 112rpx;
  font-size: var(--font-xl);
}

.char-puzzle__slots--small {
  gap: var(--space-xs);
}

.char-puzzle__slots--small .char-puzzle__slot {
  width: 88rpx;
  height: 96rpx;
  font-size: 40rpx;
}

.char-puzzle__slot--filled {
  border-color: var(--color-primary);
}

.char-puzzle__board {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: var(--space-sm);
}

.char-puzzle__key {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-sm);
  background: var(--color-surface);
  box-shadow: 0 4rpx 0 var(--color-border);
  font-size: var(--font-xl);
  font-weight: 600;
}

.char-puzzle__key--pressed {
  transform: translateY(4rpx);
  box-shadow: none;
}

.char-puzzle__board--cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

.char-puzzle__board--cols-4 .char-puzzle__key {
  height: 120rpx;
  font-size: 52rpx;
}

.char-puzzle__key--eliminated {
  background: var(--color-surface-muted);
  box-shadow: none;
  color: var(--color-ink-faint);
  text-decoration: line-through;
}

.char-puzzle__key--used {
  visibility: hidden;
}

@keyframes char-puzzle-shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-16rpx); }
  40%, 80% { transform: translateX(16rpx); }
}

.char-puzzle__slots--checking .char-puzzle__slot {
  border-color: var(--game-color);
  animation: char-puzzle-wave 0.9s ease-in-out infinite;
}

.char-puzzle__slots--checking .char-puzzle__slot:nth-child(2) { animation-delay: 0.1s; }
.char-puzzle__slots--checking .char-puzzle__slot:nth-child(3) { animation-delay: 0.2s; }
.char-puzzle__slots--checking .char-puzzle__slot:nth-child(4) { animation-delay: 0.3s; }
.char-puzzle__slots--checking .char-puzzle__slot:nth-child(5) { animation-delay: 0.4s; }
.char-puzzle__slots--checking .char-puzzle__slot:nth-child(6) { animation-delay: 0.5s; }
.char-puzzle__slots--checking .char-puzzle__slot:nth-child(7) { animation-delay: 0.6s; }

.char-puzzle__thinking {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-bottom: var(--space-md);
  opacity: 0;
  transform: translateY(10rpx) scale(0.95);
  transition: opacity 0.18s ease, transform 0.18s ease;
}

.char-puzzle__thinking--visible {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.char-puzzle__thinking-avatar {
  width: 56rpx;
  height: 56rpx;
  margin-right: 12rpx;
  border-radius: 50%;
}

.char-puzzle__thinking-bubble {
  display: flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 999rpx 999rpx 999rpx 8rpx;
  background: var(--color-surface);
  box-shadow: 0 4rpx 0 var(--color-border);
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
  font-weight: 700;
}

.char-puzzle__dots {
  display: flex;
  margin-left: 8rpx;
}

.char-puzzle__dot {
  width: 8rpx;
  height: 8rpx;
  margin: 0 3rpx;
  border-radius: 50%;
  background: var(--game-color);
  animation: char-puzzle-dot 1s ease-in-out infinite;
}

.char-puzzle__dot:nth-child(2) { animation-delay: 0.15s; }
.char-puzzle__dot:nth-child(3) { animation-delay: 0.3s; }

@keyframes char-puzzle-wave {
  0%, 60%, 100% { transform: translateY(0); }
  30% { transform: translateY(-14rpx); }
}

@keyframes char-puzzle-dot {
  0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-6rpx); }
}
