<view class="char-puzzle">
  <view class="char-puzzle__answer">
  <view class="char-puzzle__slots {{slotSizeClass}} {{isWrong ? 'char-puzzle__slots--wrong' : ''}} {{checking ? 'char-puzzle__slots--checking' : ''}} {{keyboard && inputFocused ? 'char-puzzle__slots--typing' : ''}}">
    <view wx:for="{{slots}}" wx:key="index" class="char-puzzle__cell">
      <text wx:if="{{hasPinyin}}" class="char-puzzle__pinyin">{{item.pinyin}}</text>
      <view
        class="char-puzzle__slot {{item.locked ? 'char-puzzle__slot--locked' : ''}} {{item.char ? 'char-puzzle__slot--filled' : ''}}"
        data-index="{{index}}"
        bindtap="handleSlotTap"
      >{{item.char}}</view>
    </view>
  </view>
  <!-- Keyboard mode: a see-through input over the cells, so tapping a cell brings up the phone's keyboard. -->
  <input
    wx:if="{{keyboard}}"
    class="char-puzzle__input"
    type="text"
    value="{{inputValue}}"
    focus="{{inputFocused}}"
    disabled="{{disabled}}"
    maxlength="-1"
    confirm-type="done"
    bindinput="handleInput"
    bindfocus="handleInputFocus"
    bindblur="handleInputBlur"
  />
  </view>
  <view wx:if="{{keyboard}}" class="char-puzzle__keyboard-tip">点格子用键盘输入，填满 {{freeCount}} 个字自动提交</view>
  <view class="char-puzzle__thinking {{checking ? 'char-puzzle__thinking--visible' : ''}}" aria-live="polite">
    <image class="char-puzzle__thinking-avatar" src="/assets/icons/default-avatar.png" mode="aspectFill" />
    <view class="char-puzzle__thinking-bubble">
      <text>{{thinkingLine}}</text>
      <view class="char-puzzle__dots"><view class="char-puzzle__dot"></view><view class="char-puzzle__dot"></view><view class="char-puzzle__dot"></view></view>
    </view>
  </view>

  <view wx:if="{{!keyboard}}" class="char-puzzle__board char-puzzle__board--cols-{{columns}}">
    <view
      wx:for="{{boardItems}}"
      wx:key="index"
      class="char-puzzle__key {{item.used ? 'char-puzzle__key--used' : ''}} {{item.eliminated ? 'char-puzzle__key--eliminated' : ''}}"
      hover-class="char-puzzle__key--pressed"
      data-index="{{index}}"
      bindtap="handleBoardTap"
    >{{item.char}}</view>
  </view>
</view>
