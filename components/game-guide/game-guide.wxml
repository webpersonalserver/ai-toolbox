<view wx:if="{{visible}}" class="game-guide" bindtap="handleClose">
  <view class="game-guide__panel" catchtap="noop">
    <view class="game-guide__title">{{title}}</view>
    <view wx:for="{{sections}}" wx:key="title" class="game-guide__section">
      <view class="game-guide__index">{{index + 1}}</view>
      <view class="game-guide__body">
        <view class="game-guide__section-title">{{item.title}}</view>
        <view class="game-guide__section-text">{{item.text}}</view>
      </view>
    </view>
    <button class="btn btn--primary game-guide__confirm" bindtap="handleConfirm">{{confirmText}}</button>
  </view>
</view>
