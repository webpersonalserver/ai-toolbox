<view wx:if="{{stage === 'select'}}" class="page exam-select">
  <view class="exam-select__intro">
    <view class="exam-select__title">{{unitName}} · 限时考试</view>
    <view class="exam-select__rule">每卷 {{questionCount}} 题，每题 5 分，满分 100 分。答错可以再改，答对才进入下一题，但只有第一次就答对才得分；时间到自动交卷。</view>
  </view>
  <view
    wx:for="{{levels}}"
    wx:key="level"
    class="card exam-select__level {{item.unlocked ? '' : 'exam-select__level--locked'}}"
    hover-class="exam-select__level--pressed"
    data-level="{{item.level}}"
    bindtap="chooseLevel"
  >
    <view class="exam-select__stars">{{item.unlocked ? item.stars : '🔒'}}</view>
    <view class="exam-select__body">
      <view class="exam-select__name">{{item.name}}</view>
      <view class="exam-select__time">限时 {{item.timeText}}</view>
      <view class="exam-select__best">{{item.unlocked ? item.bestText : item.lockText}}</view>
    </view>
    <view wx:if="{{item.unlocked}}" class="exam-select__go">开考 ›</view>
  </view>
</view>

<view wx:elif="{{stage === 'running'}}" class="page exam-run">
  <view class="exam-run__top">
    <view class="exam-run__level">{{level.name}} {{level.stars}}</view>
    <view class="exam-run__progress">{{progressText}}</view>
    <view class="exam-run__clock {{warning ? 'exam-run__clock--warning' : ''}}">⏱ {{clockText}}</view>
  </view>
  <view class="exam-run__track">
    <view class="exam-run__fill {{warning ? 'exam-run__fill--warning' : ''}}" style="width: {{timePercent}}%"></view>
  </view>
  <view class="exam-run__spacer"></view>
  <kungfu-question
    question="{{question}}"
    locked="{{locked}}"
    plain
    confirm-text="确定"
    max-digits="{{maxDigits}}"
    bind:answered="handleAnswered"
    bind:empty="handleEmpty"
  />
</view>

<view wx:else class="page exam-result">
  <view class="card exam-result__card">
    <view class="exam-result__mascot">{{result.mascot}}</view>
    <view class="exam-result__score {{result.isFullScore ? 'exam-result__score--full' : ''}}">{{result.score}}<text class="exam-result__unit">分</text></view>
    <view class="exam-result__grade">{{result.grade}}</view>
    <view wx:if="{{result.newBest}}" class="exam-result__badge">新纪录！</view>
    <view class="exam-result__line">{{result.correctText}}</view>
    <view class="exam-result__line">{{result.timeText}}</view>
    <view wx:if="{{result.unlockedLevelName}}" class="exam-result__unlock">🔓 解锁了{{result.unlockedLevelName}}考试！</view>
  </view>

  <view wx:if="{{result.wrongAnswers.length}}" class="card exam-result__wrong">
    <view class="exam-result__wrong-title">这几只小怪兽溜进了收容所，再看看</view>
    <view wx:for="{{result.wrongAnswers}}" wx:key="id" class="exam-result__wrong-item">
      <text>{{item.equation}}</text>
      <text class="exam-result__explain" data-index="{{item.id}}" bindtap="openExplain">🐱 喵算算教你</text>
    </view>
  </view>

  <view class="exam-result__actions">
    <button wx:if="{{result.nextLevel}}" class="btn btn--primary" bindtap="goNextLevel">挑战{{result.nextLevelName}}</button>
    <button class="btn {{result.nextLevel ? 'btn--ghost' : 'btn--primary'}}" bindtap="retry">再考一次</button>
    <button class="btn btn--muted" bindtap="backToLevels">选择等级</button>
  </view>
</view>

<practice-cheer
  visible="{{cheer.visible}}"
  title="{{cheer.title}}"
  subtitle="{{cheer.subtitle}}"
  mascot="{{cheer.mascot}}"
  big="{{cheer.big}}"
  flying-star="{{false}}"
/>

<certificate-popup
  visible="{{certificate.visible}}"
  nickname="{{certificate.nickname}}"
  achievement="{{certificate.achievement}}"
  date-text="{{certificate.dateText}}"
  bind:close="closeCertificate"
/>

<explain-sheet visible="{{explain.visible}}" steps="{{explain.steps}}" bind:close="closeExplain" />

<flower-toast visible="{{flowerToast.visible}}" count="{{flowerToast.count}}" text="{{flowerToast.text}}" />
<medal-popup visible="{{medalPopup.visible}}" is-new="{{medalPopup.isNew}}" medal="{{medalPopup.medal}}" bind:close="handleMedalClose" />
