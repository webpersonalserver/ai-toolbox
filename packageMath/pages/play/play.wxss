.drill {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.drill__topbar {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.drill__streak {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 8rpx 0 var(--color-primary-deep);
  color: var(--color-on-accent);
  line-height: 1.1;
}

.drill__streak--hot {
  background: var(--color-gold);
  box-shadow: 0 8rpx 0 var(--color-primary-deep), 0 0 0 8rpx var(--color-gold-soft);
  color: var(--color-ink);
}

.drill__streak--bump {
  animation: drill-bump 0.45s cubic-bezier(0.2, 1.8, 0.4, 1);
}

.drill__streak-label {
  font-size: 20rpx;
  font-weight: 700;
}

.drill__streak-value {
  font-size: 56rpx;
  font-weight: 900;
}

.drill__meta {
  flex: 1;
}

.drill__best {
  font-size: var(--font-lg);
  font-weight: 800;
}

.drill__stars {
  display: inline-block;
  margin-top: 4rpx;
  color: var(--color-ink);
  font-size: var(--font-md);
  font-weight: 800;
}

.drill__stars--bump {
  animation: drill-bump 0.45s cubic-bezier(0.2, 1.8, 0.4, 1) 0.6s;
}

.drill__fire {
  position: absolute;
  top: -24rpx;
  right: -16rpx;
  font-size: 48rpx;
  animation: drill-wiggle 0.6s ease-in-out infinite;
}

/* 80rpx keeps the toggle easy to hit for small fingers. */
.drill__sound {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
  min-height: 80rpx;
  border-radius: 999rpx;
  background: var(--color-surface);
  box-shadow: 0 4rpx 0 var(--color-border);
  color: var(--color-ink-soft);
  font-size: 36rpx;
  font-weight: 700;
}

.drill__record {
  margin-top: var(--space-md);
  padding: var(--space-xs) 0;
  border-radius: 999rpx;
  background: var(--color-gold);
  box-shadow: 0 6rpx 0 var(--color-primary-deep);
  color: var(--color-ink);
  font-weight: 900;
  text-align: center;
  letter-spacing: 4rpx;
  animation: drill-pop 0.5s cubic-bezier(0.2, 1.6, 0.4, 1);
}

.drill__stage {
  flex: 1;
  min-height: 0;
  /* Bleed into the page padding so the card's shake and glow are not clipped by the scroll box. */
  margin: 0 calc(-1 * var(--space-lg));
  padding: 0 var(--space-lg) var(--space-sm);
  overflow-x: hidden;
  overflow-y: auto;
}

.drill__equation {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: var(--space-sm);
  margin-top: var(--space-lg);
  padding: var(--space-xl) var(--space-md);
}

/* A one-line story above the question (公交车、小猫分糖…). */
.drill__story {
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-gold-soft);
  font-size: var(--font-md);
  font-weight: 700;
  line-height: 1.5;
}

.drill__equation--compact .drill__value,
.drill__equation--compact .drill__blank {
  height: 96rpx;
  font-size: 60rpx;
  line-height: 96rpx;
}

.drill__equation--compact .drill__blank {
  min-width: 100rpx;
  line-height: 84rpx;
}

/* 分与合: the whole on top, two branches down to its parts. Three numbers plus pictures stack tall,
   so the card and circles are tighter than the one-line equation. */
.drill__bond {
  flex-direction: column;
  align-items: center;
  gap: 0;
  margin-top: var(--space-md);
  padding: var(--space-md);
}

.drill__bond .drill__value,
.drill__bond .drill__blank {
  min-width: 132rpx;
  height: 104rpx;
  border-radius: 999rpx;
  font-size: 72rpx;
  text-align: center;
  line-height: 92rpx;
}

.drill__bond .drill__value {
  border: 6rpx solid var(--color-border);
  background: var(--color-surface);
  box-sizing: border-box;
}

.drill__bond-lines {
  position: relative;
  width: 300rpx;
  height: 60rpx;
}

.drill__bond-line {
  position: absolute;
  top: 0;
  left: 50%;
  width: 6rpx;
  height: 140rpx;
  border-radius: 3rpx;
  background: var(--color-ink-soft);
  transform-origin: top center;
}

/* Each branch ends above the centre of a part circle: 126rpx across, 60rpx down. */
.drill__bond-line--left { transform: rotate(64deg); }
.drill__bond-line--right { transform: rotate(-64deg); }

.drill__bond-parts {
  display: flex;
  justify-content: center;
  gap: 120rpx;
}

/* 比大小: three big sign buttons instead of the number keypad. */
.drill__choices {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-md);
  flex-shrink: 0;
}

.drill__choice {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: 0 8rpx 0 var(--color-border);
}

.drill__choice-sign {
  font-size: 88rpx;
  font-weight: 900;
  line-height: 1.1;
}

.drill__choice-label {
  color: var(--color-ink-soft);
  font-size: var(--font-sm);
}

.drill__equation--correct {
  animation: drill-glow 0.9s ease-out;
}

.drill__equation--wrong {
  animation: drill-shake 0.4s ease-in-out;
}

.drill__token {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.drill__value,
.drill__blank {
  height: 120rpx;
  font-size: 84rpx;
  font-weight: 900;
  line-height: 120rpx;
}

.drill__value--symbol {
  color: var(--color-ink-soft);
}

.drill__blank {
  min-width: 132rpx;
  padding: 0 var(--space-sm);
  border: 6rpx dashed var(--color-primary);
  border-radius: var(--radius-md);
  background: var(--color-primary-soft);
  color: var(--color-primary-deep);
  text-align: center;
  box-sizing: border-box;
  line-height: 108rpx;
}

.drill__blank-mark {
  opacity: 0.6;
}

.drill__blank--correct {
  border-style: solid;
  border-color: var(--color-success);
  background: var(--color-success-soft);
  color: var(--color-success-deep);
  animation: drill-pop 0.45s cubic-bezier(0.2, 1.8, 0.4, 1);
}

.drill__blank--wrong {
  border-style: solid;
  border-color: var(--color-primary-deep);
}

.drill__blank--revealed {
  border-style: solid;
  border-color: var(--color-gold);
  background: var(--color-gold-soft);
  color: var(--color-ink);
}

.drill__dots {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  width: 120rpx;
  margin-top: var(--space-xs);
}

.drill__dot {
  width: 16rpx;
  height: 16rpx;
  margin: 3rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.drill__feedback {
  min-height: 48rpx;
  margin: var(--space-sm) 0;
  color: var(--color-primary-deep);
  font-size: var(--font-md);
  font-weight: 700;
  text-align: center;
}

.drill__keypad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-sm) var(--space-md);
  flex-shrink: 0;
}

.drill__key {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 108rpx;
  border-radius: var(--radius-md);
  background: var(--color-surface);
  box-shadow: 0 8rpx 0 var(--color-border);
  font-size: 56rpx;
  font-weight: 800;
}

.drill__key--pressed {
  transform: translateY(8rpx);
  box-shadow: none;
}

.drill__key--delete {
  background: var(--color-surface-muted);
  color: var(--color-ink-soft);
}

.drill__key--confirm {
  background: var(--color-success);
  box-shadow: 0 8rpx 0 var(--color-success-deep);
  color: var(--color-on-accent);
  font-size: var(--font-lg);
}

.drill__key--locked {
  opacity: 0.55;
}

@keyframes drill-bump {
  0% { transform: scale(1); }
  40% { transform: scale(1.4); }
  100% { transform: scale(1); }
}

@keyframes drill-pop {
  0% { transform: scale(0.6); }
  100% { transform: scale(1); }
}

@keyframes drill-shake {
  0%, 100% { transform: translateX(0); }
  20%, 60% { transform: translateX(-18rpx); }
  40%, 80% { transform: translateX(18rpx); }
}

@keyframes drill-glow {
  0% { box-shadow: 0 0 0 0 var(--color-success); transform: scale(1); }
  30% { box-shadow: 0 0 0 24rpx var(--color-success-soft); transform: scale(1.04); }
  100% { box-shadow: 0 0 0 0 transparent; transform: scale(1); }
}

@keyframes drill-wiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-12deg); }
  75% { transform: rotate(12deg); }
}

.drill__reward {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-top: var(--space-md);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  background: var(--color-gold-soft);
}

.drill__reward--done {
  background: var(--color-surface-muted);
}

.drill__reward-main {
  flex: 1;
  min-width: 0;
}

.drill__reward-text {
  font-size: var(--font-sm);
  font-weight: 800;
}

.drill__reward-track {
  height: 14rpx;
  margin: 8rpx 0;
  border-radius: 999rpx;
  background: var(--color-surface);
  overflow: hidden;
}

.drill__reward-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--color-gold);
  transition: width 0.4s ease-out;
}

.drill__reward-streak {
  color: var(--color-ink-soft);
  font-size: 22rpx;
}

.drill__chest {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.drill__chest--bump {
  animation: drill-bump 0.5s cubic-bezier(0.2, 1.8, 0.4, 1);
}

.drill__chest-icon {
  font-size: 56rpx;
  line-height: 1;
}

.drill__chest-count {
  margin-top: -12rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-on-accent);
  font-size: 22rpx;
  font-weight: 900;
}

/* ----- 数理乐园 additions ----- */
.drill__round {
  display: flex;
  gap: 10rpx;
}

.drill__round-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: var(--color-surface);
  box-shadow: inset 0 0 0 3rpx var(--color-border);
}

.drill__round-dot--current {
  box-shadow: inset 0 0 0 4rpx var(--color-primary);
  animation: drill-bump 1.2s ease-in-out infinite;
}

.drill__round-dot--first { background: var(--color-gold); box-shadow: none; }
.drill__round-dot--retry { background: var(--color-success); box-shadow: none; }
.drill__round-dot--revealed { background: var(--color-primary-soft); box-shadow: inset 0 0 0 3rpx var(--color-primary); }

.drill__picture {
  margin-top: var(--space-xs);
}

.drill__helpers {
  display: flex;
  justify-content: center;
  min-height: 72rpx;
}

.drill__explain {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--color-gold);
  box-shadow: 0 6rpx 0 var(--color-primary-deep);
  font-weight: 900;
  animation: drill-pop 0.4s cubic-bezier(0.2, 1.8, 0.4, 1);
}

.drill__explain--pressed {
  transform: translateY(6rpx);
  box-shadow: none;
}

.round {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 46;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 var(--space-lg);
  background: var(--color-overlay);
}

.round__card {
  width: 100%;
  padding: var(--space-xl) var(--space-lg);
  border-radius: var(--radius-lg);
  background: var(--color-bg);
  box-shadow: 0 16rpx 0 var(--color-primary-deep);
  text-align: center;
  box-sizing: border-box;
  animation: drill-pop 0.45s cubic-bezier(0.2, 1.6, 0.4, 1);
}

.round__star {
  display: inline-block;
  margin: 0 10rpx;
  color: var(--color-border);
  font-size: 110rpx;
}

.round__monsters {
  font-size: 110rpx;
  animation: drill-pop 0.5s cubic-bezier(0.2, 1.8, 0.4, 1) both;
}

.round__star--on {
  color: var(--color-gold);
  text-shadow: 0 8rpx 0 var(--color-primary-deep);
  animation: drill-pop 0.5s cubic-bezier(0.2, 1.8, 0.4, 1) both;
}

.round__star--1.round__star--on { animation-delay: 0.2s; }
.round__star--2.round__star--on { animation-delay: 0.5s; }
.round__star--3.round__star--on { animation-delay: 0.8s; }

.round__talk {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: var(--space-md);
  text-align: left;
}

.round__cat {
  flex-shrink: 0;
  width: 110rpx;
  height: 110rpx;
}

.round__line {
  flex: 1;
  padding: var(--space-md);
  border-radius: 8rpx 36rpx 36rpx 36rpx;
  background: var(--color-surface);
  box-shadow: 0 6rpx 0 var(--color-border);
  font-size: var(--font-lg);
  font-weight: 900;
}

.round__detail {
  margin-top: var(--space-md);
  color: var(--color-ink-soft);
}

.round__hint {
  margin-top: 4rpx;
  color: var(--color-primary-deep);
  font-weight: 800;
}

.btn.round__action {
  width: 100%;
  margin-top: var(--space-md);
}

.round__back {
  margin-top: var(--space-md);
  padding: 24rpx 0;
  color: var(--color-ink-soft);
}

/* Short screens (iPhone SE class): shrink the keys a little so the question keeps most of the room. */
@media (max-height: 640px) {
  .drill__key {
    height: 92rpx;
  }

  .drill__choice {
    height: 150rpx;
  }
}
