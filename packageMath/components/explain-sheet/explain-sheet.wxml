<view wx:if="{{visible && shown.length}}" class="es" catchtouchmove="noop">
  <view class="es__panel">
    <view class="es__progress">
      <view wx:for="{{steps}}" wx:for-index="pipIndex" wx:key="pipIndex" class="es__pip {{pipIndex <= index ? 'es__pip--on' : ''}}"></view>
    </view>
    <!-- One item keyed by step id: each step is rendered fresh, so its pop-in animation plays again. -->
    <view wx:for="{{shown}}" wx:key="id" class="es__step">
      <view class="es__talk">
        <image class="es__cat" src="{{mascot.images.normal}}" mode="aspectFit" />
        <view class="es__bubble">{{item.say}}</view>
      </view>
      <view class="es__math">{{item.math}}</view>
      <view wx:if="{{item.picture}}" class="es__picture">
        <number-picture picture="{{item.picture}}" size="large" />
      </view>
    </view>
    <view class="btn btn--primary es__next" bindtap="next">{{isLast ? labels.done : labels.next}}</view>
  </view>
</view>
